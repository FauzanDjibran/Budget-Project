model MCashBank {
  id              Int          @id @default(autoincrement())
  cash_bank_code  String       @unique
  cash_bank_label String
  cash_bank_name  String
  company_id      Int
  cash_bank_type  CashBankType
  currency_id     Int
  account_id      Int
  note            String?
  status          ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  company  SysCompany  @relation(fields: [company_id], references: [id])
  currency RefCurrency @relation(fields: [currency_id], references: [id])
  account  AccAccount  @relation(fields: [account_id], references: [id])

  transactions     FinCashBankTransaction[]
  transfers_out    FinCashBankTransfer[]
  transfers_in     FinCashBankTransferLine[]
  conversions_out  FinItemConversion[]
  conversions_in   FinItemConversionLine[]
  revaluations     FinCashBankRevaluation[]
  ledger           CashBankLedger[]
  layers           CashBankLayer[]
  book_balance     CashBankBalance?
  book_periods     CashBankPeriod[]
  funding_requests FinFundingRequest[]

  @@index([company_id])
  @@map("m_cash_bank")
}

// ---------------------------------------------------------------- cash bank book
//
// The Cash Bank Book: an independent, append-only record of every movement
// through a cash or bank resource, plus the balance it adds up to.
//
// `cash_bank_ledger` is the truth. Entries are never edited and never deleted —
// a mistake is corrected by a further entry, which is what makes the book
// auditable. `cash_bank_balance` is a materialised running total kept in step
// inside the same transaction as the entry that moved it, so reading a balance
// costs one row instead of a scan.
//
// The concept doc requires this book to stay independent of the journal: it is
// never a view over journal lines. Only the General Ledger derives from
// journals.

enum CashBankEntryType {
  /// The balance a resource starts with, written once when it is registered.
  Opening
  /// A posted cash/bank transaction.
  Transaction
  /// A manual correction, recorded rather than edited into an existing entry.
  Adjustment
  /// A Revaluasi Kurs: no currency moves (`movement` is nil) and the base
  /// measure is restated to the kurs the user stated.
  Revaluation
}

model CashBankLedger {
  id              Int               @id @default(autoincrement())
  entry_no        String            @unique
  cash_bank_id    Int
  accounting_date DateTime          @db.Date
  /// When the document that wrote it was posted, by the default inside that
  /// document's Post: `transaction_timestamp()`, so every row one Post writes
  /// carries the same value. Backdating shows as `posted_at` after `accounting_date`.
  posted_at       DateTime          @default(dbgenerated("transaction_timestamp()")) @db.Timestamptz(6)
  entry_type      CashBankEntryType

  /// The movement, signed: positive money in, negative money out. The sign
  /// **is** the direction — one column, so the two can never disagree — and
  /// summing it reconstructs the balance from scratch, which is how the
  /// materialised total is verified.
  /// There is no running balance: an entry may be backdated in among entries
  /// written before it, so a balance "after" it would follow write order, not
  /// date. A balance on a date is summed from `movement`.
  movement Decimal @db.Decimal(18, 2)

  /// The kurs this movement was valued at, always converting the resource's
  /// own currency to the base currency.
  ///
  /// **This book's own rate**, not necessarily the one another book recorded
  /// for the same document. A payment has two rates that need not agree — what
  /// the cash cost and what the obligation was carried at — and putting both on
  /// one row would make that row's own arithmetic fail. Each book takes the
  /// rate belonging to its own side, so `base_movement ÷ movement` always
  /// equals the rate recorded here and the book stays independently re-derivable. The
  /// two sides meet in the journal, and the residual is recognised there.
  ///
  /// `1` means the money is base currency, and nothing else: a rate of 1
  /// between two foreign amounts would assert that USD 100 is IDR 100.
  rate          Decimal @db.Decimal(18, 6)
  /// `movement` in base currency, signed the same way. Stored rather than
  /// derived: base value is a record of how the balance was built, and
  /// re-deriving it at a current rate would destroy the only figure that says
  /// what currency movement cost. Summing it rebuilds the base balance exactly
  /// as `movement` rebuilds the foreign one.
  base_movement Decimal @db.Decimal(18, 2)

  /// What caused the movement. Null for an opening balance, which has no
  /// source document — the registration of the resource is the event.
  source_doc_type_id Int?
  source_doc_id      Int?

  note String?

  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  cash_bank       MCashBank   @relation(fields: [cash_bank_id], references: [id])
  source_doc_type SysDocType? @relation(fields: [source_doc_type_id], references: [id])

  @@index([cash_bank_id, accounting_date])
  @@index([source_doc_type_id, source_doc_id])
  @@map("cash_bank_ledger")
}

/// One row per cash/bank resource, derived from `cash_bank_ledger` and written
/// in the same transaction as the entry that changed it. Never written on its
/// own: `rebuildCashBankBalance` recomputes it from the ledger.
model CashBankBalance {
  id              Int       @id @default(autoincrement())
  cash_bank_id    Int       @unique
  balance         Decimal   @default(0) @db.Decimal(18, 2)
  /// The same balance in base currency. A resource's carrying rate is
  /// `base_balance ÷ balance`, derived on read and never stored — it is an
  /// effective rate that will generally equal no rate anyone transacted at.
  base_balance    Decimal   @default(0) @db.Decimal(18, 2)
  entry_count     Int       @default(0)
  last_entry_id   Int?
  last_entry_date DateTime? @db.Date

  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  cash_bank MCashBank @relation(fields: [cash_bank_id], references: [id])

  @@map("cash_bank_balance")
}

/// One row per resource per calendar month, so a backdated movement can be
/// checked without reading the book from its first entry. Written only by
/// `recordCashBankEntry`, in the same transaction as the entry; the months of
/// one resource form an unbroken chain from its first entry's month to its
/// latest. Keyed on the month rather than on `acc_fiscal_period`: a fiscal year
/// may be missing (2028 open without 2027), and a book depends on no module.
model CashBankPeriod {
  id           Int      @id @default(autoincrement())
  cash_bank_id Int
  /// The first day of the month.
  period       DateTime @db.Date

  /// In the resource's own currency. `closing = opening + total_in - total_out`,
  /// and the next month's `opening` is this `closing`.
  opening     Decimal @default(0) @db.Decimal(18, 2)
  total_in    Decimal @default(0) @db.Decimal(18, 2)
  total_out   Decimal @default(0) @db.Decimal(18, 2)
  closing     Decimal @default(0) @db.Decimal(18, 2)
  /// The lowest the balance stands at any moment of the month, the opening
  /// included. A backdated movement shifts every later month by the same
  /// amount, so `MIN(min_balance) + movement` over them answers whether any of
  /// them would go below zero without reading their entries.
  min_balance Decimal @default(0) @db.Decimal(18, 2)

  /// The same four in base currency, for the reports. Not validated: a
  /// revaluation moves base alone, and what may not go negative is the money.
  /// A movement of nil (a revaluation) counts on the out side, as the Buku
  /// Kas & Bank report places it.
  base_opening   Decimal @default(0) @db.Decimal(18, 2)
  base_total_in  Decimal @default(0) @db.Decimal(18, 2)
  base_total_out Decimal @default(0) @db.Decimal(18, 2)
  base_closing   Decimal @default(0) @db.Decimal(18, 2)

  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  cash_bank MCashBank @relation(fields: [cash_bank_id], references: [id])

  @@unique([cash_bank_id, period])
  @@map("cash_bank_period")
}

// ------------------------------------------------------------- rate layers

enum CashBankLayerStatus {
  /// Still holds currency, and may be chosen for a payment.
  Open
  /// Drawn down to nothing. Kept for audit, never offered again.
  Exhausted
  /// Collapsed by a Revaluasi Kurs, which replaced every open layer of the
  /// resource with one at the kurs it stated. Never reopened; which document
  /// closed it is `fin_cash_bank_revaluation_layer`.
  ClosedByRevaluation
}

/// A rate layer: currency a foreign resource acquired at one known kurs.
///
/// A **base-currency resource has no layers at all** — it holds rupiah, which
/// is already the measure everything is reported in. Layers exist because
/// foreign currency bought at 15.000 and foreign currency bought at 16.000 are
/// not interchangeable: spending one rather than the other produces a
/// different gain or loss, and that is a decision somebody makes rather than an
/// average the system computes.
///
/// **A layer is identified by the event that created it, never by its rate.**
/// Two receipts at an identical kurs are two layers and are never joined. That
/// is why a user picks a *layer* — "the one from 28 January" — and not a rate:
/// with three layers at 15.000, "use the 15.000" names none of them.
///
/// **The rate is immutable for the layer's life.** Consumption releases base in
/// proportion to what is left, so `base_remaining / foreign_remaining` equals
/// `rate` throughout — which is what makes a layer's rate stable against being
/// spent, and what lets the account's own weighted-average rate stay a
/// reporting figure that values nothing.
///
/// Unlike the books beside it this table is **mutable**, and deliberately: the
/// remaining balance is the figure a payment is checked against, and it is what
/// the user picks from. The immutable record of what was consumed lives on the
/// documents that consumed it.
model CashBankLayer {
  id           Int    @id @default(autoincrement())
  layer_no     String @unique
  cash_bank_id Int

  /// Drives FIFO ordering, which governs *display* only. Consumption is always
  /// the user's explicit choice — an implementation that consumed oldest-first
  /// on its own would not be this feature.
  acquisition_date DateTime @db.Date
  /// Tiebreaker within a date, so ordering is total rather than merely mostly.
  acquisition_seq  Int

  /// The kurs this currency was acquired at, to the base currency. Immutable.
  rate              Decimal @db.Decimal(18, 6)
  foreign_original  Decimal @db.Decimal(18, 2)
  base_original     Decimal @db.Decimal(18, 2)
  /// What is left. Drawn down by payments; never edited by hand.
  foreign_remaining Decimal @db.Decimal(18, 2)
  base_remaining    Decimal @db.Decimal(18, 2)

  status CashBankLayerStatus @default(Open)

  /// What brought the currency in — the same weak document pair every book
  /// uses. Null for the opening layer, whose event is the registration itself.
  source_doc_type_id Int?
  source_doc_id      Int?

  note String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  cash_bank             MCashBank               @relation(fields: [cash_bank_id], references: [id])
  source_doc_type       SysDocType?             @relation(fields: [source_doc_type_id], references: [id])
  general_journal_lines AccGeneralJournalLine[]

  @@index([cash_bank_id, status, acquisition_date, acquisition_seq])
  @@index([source_doc_type_id, source_doc_id])
  @@map("cash_bank_layer")
}

// ----------------------------------------------------------------- subledger

/// An entry in a subledger, which is what a `CashBankEntryType` is to the Cash
/// Bank Book. Its own enum rather than a shared one: a module that is meant to
/// be liftable does not take its types from another module's table.
enum SubLedgerEntryType {
  /// A subject's position before the application started keeping its book.
  /// Nothing writes one yet — it arrives with Opening Balance.
  Opening
  /// A posted Cash Bank Transaction.
  Transaction
  /// A manual correction, recorded rather than edited into an existing entry.
  Adjustment
  /// A Pencairan Open Item: a foreign item released at its own kurs, and the
  /// base-currency item it became, opened beside it in the same book.
  Conversion
  /// A Reklasifikasi Open Item: an item released out of one book, and the item
  /// it became — or the item it settled — in another book or for another
  /// Partner. No cash moves.
  Reclass
}

/// Whether an open item still holds anything.
enum SubLedgerItemStatus {
  /// Still holds a remaining amount, and may be chosen by a line that lowers
  /// its position.
  Open
  /// Relieved to nothing. Kept, because it is part of how the position was
  /// built, and never offered again.
  Cleared
}

/// The subject books — Titipan, Hutang, Piutang, Prive, Investasi and Hasil
/// Investasi — in one append-only table, keyed by `book`.
///
/// The subject is a **Partner** (concept doc §11.3-§11.6, §12), and every
/// entry is written straight from the business transaction at Post, alongside
/// the Cash Bank Book and the Journal. It is never derived from a journal
/// line: an operational book is an independent historical store, and only the
/// General Ledger reads the journal (§13, §14).
///
/// One table with a `book` discriminator rather than six identical tables. The
/// books differ only in which cash direction raises their subject's position,
/// which is a catalogue entry in `lib/siba/subledger-catalogue.ts` — six tables
/// would be six copies of one shape, and adding the seventh would be a
/// migration instead of a line of config.
///
/// The book is named by `budget_category_id`, a foreign key to the Budget
/// Category that keeps it — reference data, like the Partner and the Currency
/// beside it (CLAUDE.md §3, cross-module references). It used to be the
/// category's code as text; an id cannot drift from the row it names.
model SubLedger {
  id                 Int                @id @default(autoincrement())
  entry_no           String             @unique
  /// The Budget Category whose book this entry belongs to.
  budget_category_id Int
  partner_id         Int
  currency_id        Int
  accounting_date    DateTime           @db.Date
  /// When the document that wrote it was posted, by the default inside that
  /// document's Post: `transaction_timestamp()`, so every row one Post writes
  /// carries the same value. Backdating shows as `posted_at` after `accounting_date`.
  posted_at          DateTime           @default(dbgenerated("transaction_timestamp()")) @db.Timestamptz(6)
  entry_type         SubLedgerEntryType

  /// The movement, signed in the **book's** direction: positive where the
  /// entry raises the subject's position, negative where it lowers it. The one
  /// statement of which way it went — the cash direction behind it follows from
  /// the sign and the category's `raises`, which is fixed once the book has an
  /// entry. Summing this column reconstructs the balance, which is how the
  /// total is verified. No running balance, for the reason `cash_bank_ledger`
  /// gives: an entry may be backdated.
  movement Decimal @db.Decimal(18, 2)

  /// **This book's own settlement rate**, converting the subject's currency to
  /// the base currency — not necessarily the rate the Cash Bank Book recorded
  /// for the same document.
  ///
  /// An entry that *raises* a position originates its base value at the rate
  /// the money moved at. An entry that *relieves* one releases base at the rate
  /// the position was already carried at, which is usually a different number:
  /// a debt taken on when a dollar cost 15.000 and settled with dollars costing
  /// 16.000 releases at 15.000. The gap between the two books is the FX
  /// difference, and it lives in the journal rather than in either book.
  rate          Decimal @db.Decimal(18, 6)
  /// `movement` in base currency, signed the same way.
  base_movement Decimal @db.Decimal(18, 2)

  /// The open item this entry moved. An entry that raises a position opens a
  /// new item and names it; one that lowers a position names the item the user
  /// chose and relieves it at that item's own rate. Summing an item's entries
  /// rebuilds it, which is what keeps a mutable item provable from an
  /// append-only book.
  balance_id Int

  /// What caused the movement, as the weak document pair every book uses.
  source_doc_type_id Int?
  source_doc_id      Int?

  note String?

  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  budget_category SysBudgetCategory @relation(fields: [budget_category_id], references: [id])
  partner         MPartner          @relation(fields: [partner_id], references: [id])
  currency        RefCurrency       @relation(fields: [currency_id], references: [id])
  source_doc_type SysDocType?       @relation(fields: [source_doc_type_id], references: [id])
  item            SubLedgerBalance  @relation(fields: [balance_id], references: [id])

  @@index([budget_category_id, partner_id, accounting_date])
  @@index([balance_id])
  @@index([source_doc_type_id, source_doc_id])
  @@map("sub_ledger")
}

/// The **open items** of the subject books: one row per movement that raised a
/// position, and the balance and the item are the same row.
///
/// A position — book × Partner × currency — is no longer a row. It is the sum
/// of its items, computed on read. Each item keeps what it was raised at, so a
/// line that lowers the position names the item it settles and relieves it at
/// that item's own rate, rather than at an average of every receipt: two
/// Titipan received at 15.000 and 13.000 stay two items, and which one a
/// return settles is a choice the user makes and can see. Rupiah is itemised
/// too, at a rate of 1 — the item is a matching unit as well as a rate.
///
/// Derived from `sub_ledger` and written in the same transaction as the entry
/// that moved it, never on its own: `rebuildSubledgerBalance` recomputes an item
/// from the entries that name it. Mutable, unlike the book, and provable from
/// the book for exactly that reason.
///
/// Nothing may take an item below nothing, so no position can go negative.
model SubLedgerBalance {
  id                 Int    @id @default(autoincrement())
  /// `SBI-0001`. How the picker and the reports name an item — a rate names
  /// several items at once and a date names every item raised that day.
  item_no            String @unique
  /// The Budget Category whose book this item belongs to.
  budget_category_id Int
  partner_id         Int
  currency_id        Int

  /// When the item was raised: the document date of the entry that opened it.
  opened_date   DateTime @db.Date
  /// The rate the item was raised at — a fact of the movement that raised it,
  /// in the same sense as a rate layer's. Relief releases base in proportion to
  /// what is left, so `base_balance ÷ balance` equals it for the item's life.
  rate          Decimal  @db.Decimal(18, 6)
  /// What the item was raised by, on both measures. Never changes.
  original      Decimal  @db.Decimal(18, 2)
  base_original Decimal  @db.Decimal(18, 2)

  /// What remains of the item, in its own currency.
  balance         Decimal             @default(0) @db.Decimal(18, 2)
  /// What remains of the item in base currency.
  base_balance    Decimal             @default(0) @db.Decimal(18, 2)
  status          SubLedgerItemStatus @default(Open)
  entry_count     Int                 @default(0)
  last_entry_id   Int?
  last_entry_date DateTime?           @db.Date

  /// The document that raised the item, as the weak pair every book uses, and
  /// the words it was raised under — the Budget's own description.
  source_doc_type_id Int?
  source_doc_id      Int?
  note               String?

  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  budget_category SysBudgetCategory @relation(fields: [budget_category_id], references: [id])
  partner         MPartner          @relation(fields: [partner_id], references: [id])
  currency        RefCurrency       @relation(fields: [currency_id], references: [id])
  entries         SubLedger[]

  @@index([budget_category_id, partner_id, currency_id, status])
  @@map("sub_ledger_balance")
}

// ---------------------------------------------------------------- accounting

model AccAccountCategory {
  id              Int              @id @default(autoincrement())
  account_type_id Int
  category_code   String           @unique
  /// The category's place in the chart of accounts: its account type's code
  /// plus one segment, e.g. `1.1` under type `1`. Not in the DBML, which
  /// carried no numbering scheme — see lib/siba/account-code.ts.
  category_label  String           @unique
  category_name   String
  /// The Laba Rugi step this category belongs to. Set exactly when the
  /// category's type is `ProfitLoss`, null on every Neraca category. Seeded
  /// from Template COA Sheet1, never edited, on no form — an account inherits
  /// its step through subcategory -> category, so a new account needs no setup.
  pl_group        ProfitLossGroup?
  note            String?
  status          ActiveStatus     @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  account_type  SysAccountType          @relation(fields: [account_type_id], references: [id])
  subcategories AccAccountSubcategory[]

  @@index([account_type_id])
  @@map("acc_account_category")
}

model AccAccountSubcategory {
  id                  Int          @id @default(autoincrement())
  account_category_id Int
  subcategory_code    String       @unique
  /// Its category's code plus one segment, e.g. `1.1.1`. Every account
  /// number starts from one of these, so it is unique across the chart.
  subcategory_label   String       @unique
  subcategory_name    String
  note                String?
  status              ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  account_category AccAccountCategory @relation(fields: [account_category_id], references: [id])
  accounts         AccAccount[]

  @@index([account_category_id])
  @@map("acc_account_subcategory")
}

model AccAccount {
  id                     Int           @id @default(autoincrement())
  account_subcategory_id Int
  account_code           String        @unique
  /// The account number, continuing whatever the account hangs under: its
  /// subcategory's code (`1.1.1` -> `1.1.1.2`) or its parent account's
  /// (`1.1.1.2` -> `1.1.1.2.1`). Unique within a company — see @@unique
  /// below. The DBML only constrained the generated account_code globally.
  account_label          String
  account_name           String
  company_id             Int
  parent_account         Int?
  is_postable            Boolean       @default(true)
  normal_balance         NormalBalance
  /// Not in the DBML. Locks a subledger account to a single partner category so
  /// subject histories never mix. Replaces the DBML's `partner_type`. Set
  /// exactly when the ledger takes a Partner (`partner`, `subject_book`).
  partner_category_id    Int?
  /// Which ledger the account belongs to (Journal 2.0 D18): what a line on it
  /// must name. `partner` and `subject_book` take a Partner on every line
  /// (it replaced `require_partner`); `subject_book` names its one book in
  /// `ledger_book_id`; `cash_bank` is what a Cash & Bank resource posts to.
  /// Locked once the account has a journal line.
  ledger                 AccountLedger @default(none)
  ledger_book_id         Int?
  is_control_account     Boolean       @default(false)
  note                   String?
  is_active              Boolean       @default(true)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  ledger_book         SysBudgetCategory?    @relation(fields: [ledger_book_id], references: [id])
  account_subcategory AccAccountSubcategory @relation(fields: [account_subcategory_id], references: [id])
  company             SysCompany            @relation(fields: [company_id], references: [id])
  partner_category    SysPartnerCategory?   @relation(fields: [partner_category_id], references: [id])
  parent              AccAccount?           @relation("AccountTree", fields: [parent_account], references: [id])
  children            AccAccount[]          @relation("AccountTree")

  cash_banks    MCashBank[]
  mappings      AccBudgetCategoryAccount[]
  journal_lines AccJournalLine[]

  opening_balance_lines AccOpeningBalanceLine[]
  system_accounts       AccSystemAccount[]
  general_journal_lines AccGeneralJournalLine[]

  @@unique([company_id, account_label])
  @@index([company_id])
  @@index([account_subcategory_id])
  @@map("acc_account")
}

model AccBudgetCategoryAccount {
  id                  Int    @id @default(autoincrement())
  bca_code            String @unique
  budget_category_id  Int
  company_id          Int
  /// Not in the DBML. Without it a single budget category cannot resolve to a
  /// different account per partner category.
  partner_category_id Int?
  account_id          Int

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  budget_category  SysBudgetCategory   @relation(fields: [budget_category_id], references: [id])
  company          SysCompany          @relation(fields: [company_id], references: [id])
  partner_category SysPartnerCategory? @relation(fields: [partner_category_id], references: [id])
  account          AccAccount          @relation(fields: [account_id], references: [id])

  @@unique([company_id, budget_category_id, partner_category_id])
  @@index([company_id])
  @@map("acc_budget_category_account")
}

/// One Company's fiscal year. Each Company keeps its own calendar, so it
/// activates, locks and closes its years without waiting on the other.
model AccFiscalYear {
  id         Int          @id @default(autoincrement())
  company_id Int
  year_code  String       @unique
  year_label String
  year_name  String
  start_date DateTime     @db.Date
  end_date   DateTime     @db.Date
  note       String?
  status     FiscalStatus @default(Draft)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  company  SysCompany         @relation(fields: [company_id], references: [id])
  periods  AccFiscalPeriod[]
  closings AccFiscalClosing[]

  /// The snapshot this year opens with, and the snapshots this year's own
  /// close produced for the year after it. Two relations to one table, so
  /// each is named — see `AccOpeningBalance`.
  opening_balances         AccOpeningBalance[] @relation("OpeningBalanceYear")
  sourced_opening_balances AccOpeningBalance[] @relation("OpeningBalanceSource")

  @@unique([company_id, year_label])
  @@map("acc_fiscal_year")
}

model AccFiscalPeriod {
  id             Int                @id @default(autoincrement())
  fiscal_year_id Int
  /// The year's Company, copied when the periods are generated so a date can
  /// be resolved to one Company's period by a unique key.
  company_id     Int
  sequence_no    Int
  period_code    String             @unique
  period_label   String
  period_name    String
  start_date     DateTime           @db.Date
  end_date       DateTime           @db.Date
  note           String?
  status         FiscalPeriodStatus @default(Open)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  fiscal_year AccFiscalYear @relation(fields: [fiscal_year_id], references: [id])
  company     SysCompany    @relation(fields: [company_id], references: [id])

  @@unique([company_id, start_date])
  @@index([fiscal_year_id])
  @@map("acc_fiscal_period")
}

/// One Company's closing state for one fiscal year.
///
/// The fiscal calendar is global — one set of years and periods, shared by both
/// Companies (see `AccFiscalYear`) — but closing is not: the induk can shut
/// 2026 while the anak is still finishing it. That state needs somewhere to
/// live, and this is it.
///
/// An explicit record rather than a status inferred from the existence of an
/// Opening Balance document. Inferring a fact from a row in another table is
/// the same habit `AccountSection` exists to stop: it works until somebody
/// writes that row for a second reason, and then nothing fails.
///
/// `AccFiscalYear.status` is a **rollup** over these: the year reads Closed once
/// every Company has closed it.
model AccFiscalClosing {
  id             Int                 @id @default(autoincrement())
  fiscal_year_id Int
  company_id     Int
  status         FiscalClosingStatus @default(Open)

  closed_at DateTime? @db.Timestamptz(6)
  /// Plain Int with no FK, exactly like `created_by` elsewhere — the DBML
  /// declares authorship that way throughout.
  closed_by Int?

  /// The `CLS-` journal this close produced, and the `OPB-` snapshot it wrote
  /// for the following year. Both are other modules' documents, so they are
  /// held as ids rather than as relations (CLAUDE.md §3): a relation would put
  /// a back-reference on `acc_journal`, which is a book and is meant to be
  /// liftable. Null until a close actually happens — nothing writes either yet.
  closing_journal_id Int?
  opening_balance_id Int?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  fiscal_year AccFiscalYear @relation(fields: [fiscal_year_id], references: [id])
  company     SysCompany    @relation(fields: [company_id], references: [id])

  @@unique([fiscal_year_id, company_id])
  @@index([company_id])
  @@map("acc_fiscal_closing")
}

/// One Company's balances at the start of one fiscal year — a snapshot, not a
/// running store.
///
/// It exists so that a report does not have to scan from the first historical
/// transaction to work out where an account stood, and so that a closed year
/// hands the next one its position in a form somebody can read. It is
/// **immutable**: written once, by a close or by a developer injecting go-live
/// figures, and never edited afterwards. There is no create form and no edit
/// path in the application.
///
/// Base currency only, deliberately: the journal, the General Ledger and the
/// Trial Balance are all base-currency statements, and a snapshot of them is
/// the same measure. That is why there is no `currency_id` here.
///
/// `source_fiscal_year_id` is what tells a generated snapshot from an injected
/// one. A close writes the year it closed; a developer seeding go-live
/// balances leaves it null, because nothing produced them.
model AccOpeningBalance {
  id              Int      @id @default(autoincrement())
  opening_no      String   @unique
  /// The day the figures speak for — the first day of the year being opened.
  accounting_date DateTime @db.Date
  /// When the close (or the go-live injection) wrote it.
  posted_at       DateTime @default(dbgenerated("transaction_timestamp()")) @db.Timestamptz(6)

  /// The year this snapshot opens.
  fiscal_year_id        Int
  /// The year whose close produced it, or null for injected go-live balances.
  source_fiscal_year_id Int?

  company_id Int

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  fiscal_year        AccFiscalYear  @relation("OpeningBalanceYear", fields: [fiscal_year_id], references: [id])
  source_fiscal_year AccFiscalYear? @relation("OpeningBalanceSource", fields: [source_fiscal_year_id], references: [id])
  company            SysCompany     @relation(fields: [company_id], references: [id])

  lines AccOpeningBalanceLine[]

  /// One snapshot per Company per year. A second would be a second answer to
  /// "where did this Company stand on 1 January", and the document is
  /// immutable, so there is no legitimate way to reach two.
  @@unique([fiscal_year_id, company_id])
  @@index([company_id])
  @@map("acc_opening_balance")
}

/// One balance, at the grain the journal itself keeps: `(account, partner?)`.
///
/// A Hutang account owed to three branches produces three lines; an account
/// naming no Partner produces one line with `partner_id = null`. There is
/// deliberately **no** parent row holding the account's total — that figure is
/// the sum of its children, and an immutable snapshot has no rebuild function
/// to prove a stored duplicate still agrees with what it duplicates.
///
/// The grain is derived from the posted journal lines as they actually are,
/// never from `acc_account.require_partner`: reading the flag would drop a
/// partner-bearing balance sitting on an unflagged account, and would invent a
/// null-partner line for an account that has none.
///
/// Exactly one of `debit_amount` / `kredit_amount` carries the value, and the
/// document's two sides sum equal — after the P&L has been closed out, what
/// remains is a balance sheet.
model AccOpeningBalanceLine {
  id          Int @id @default(autoincrement())
  opening_id  Int
  sequence_no Int

  account_id Int
  partner_id Int?

  /// Base currency, like every figure in the journal this is a snapshot of.
  debit_amount  Decimal @default(0) @db.Decimal(18, 2)
  kredit_amount Decimal @default(0) @db.Decimal(18, 2)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  opening AccOpeningBalance @relation(fields: [opening_id], references: [id])
  account AccAccount        @relation(fields: [account_id], references: [id])
  partner MPartner?         @relation(fields: [partner_id], references: [id])

  /// One line per pair. The index is created `NULLS NOT DISTINCT` in the
  /// migration's own SQL — Postgres otherwise treats two null-partner rows for
  /// one account as distinct, which is precisely the duplicate this is for.
  /// Prisma cannot express that, so the migration says it and this says why.
  @@unique([opening_id, account_id, partner_id])
  @@index([opening_id])
  @@map("acc_opening_balance_line")
}

// ---------------------------------------------------------------- budget

model BudBudget {
  id              Int           @id @default(autoincrement())
  budget_no       String        @unique
  budget_date     DateTime      @db.Date
  company_id      Int
  currency_id     Int
  budget_type     FlowDirection
  /// Both stay null until an approver classifies the budget.
  category_id     Int?
  partner_id      Int?
  description     String
  budget_amount   Decimal       @db.Decimal(18, 2)
  realized_amount Decimal       @default(0) @db.Decimal(18, 2)
  status          BudgetStatus  @default(Draft)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  company  SysCompany         @relation(fields: [company_id], references: [id])
  currency RefCurrency        @relation(fields: [currency_id], references: [id])
  category SysBudgetCategory? @relation(fields: [category_id], references: [id])
  partner  MPartner?          @relation(fields: [partner_id], references: [id])

  @@index([company_id])
  @@index([status])
  @@index([budget_date])
  @@map("bud_budget")
}

// ---------------------------------------------------------------- finance

model FinCashBankTransaction {
  id                 Int           @id @default(autoincrement())
  transaction_no     String        @unique
  /// The day the document belongs to in the books, chosen on the draft — any
  /// day up to today. Every book entry and the journal Post writes are dated
  /// by it; `posted_at` is when Post actually ran. Nullable only for drafts
  /// saved before drafts carried a date, which post as today.
  accounting_date    DateTime?     @db.Date
  posted_at          DateTime?     @db.Timestamptz(6)
  transaction_type   FlowDirection
  company_id         Int
  cash_bank_id       Int?
  /// The currency the document is denominated in — a real input now, not a
  /// figure read off the Cash & Bank. A foreign document may be paid from a
  /// resource in its own currency or from a base-currency one, so the two are
  /// no longer the same question.
  currency_id        Int
  /// The kurs this document was valued at: its own currency to the base one.
  /// Read off the chosen layer where one is consumed, typed where the bank did
  /// the converting, and `1` only when the money is already base currency.
  exchange_rate      Decimal       @default(1) @db.Decimal(18, 6)
  /// The rate layer this payment drew on. One transaction, one bank, one kurs
  /// — so this is a header column rather than a join table, and the document is
  /// capped at what this layer still holds.
  ///
  /// Null whenever no layer is involved: money coming in, a base-currency
  /// resource, or a document still in Draft that has not chosen one.
  cash_bank_layer_id Int?

  transaction_amount      Decimal @db.Decimal(18, 2)
  /// What the document was worth in base currency. No longer the identity.
  transaction_base_amount Decimal @db.Decimal(18, 2)

  note   String?
  status TransactionStatus @default(Draft)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  company   SysCompany  @relation(fields: [company_id], references: [id])
  currency  RefCurrency @relation(fields: [currency_id], references: [id])
  cash_bank MCashBank?  @relation(fields: [cash_bank_id], references: [id])

  lines            FinCashBankTransactionLine[]
  funding_requests FinFundingRequest[]

  @@index([company_id])
  @@index([status])
  @@map("fin_cash_bank_transaction")
}

model FinCashBankTransactionLine {
  id             Int @id @default(autoincrement())
  transaction_id Int
  sequence_no    Int

  /// Deliberately generic so a line can settle any document type. V1 only ever
  /// uses doc type = Budget.
  source_doc_type_id Int
  source_doc_id      Int

  /// Snapshot of what was settleable at the time, in the source currency.
  outstanding_amount Decimal @db.Decimal(18, 2)

  settlement_amount        Decimal  @db.Decimal(18, 2)
  /// What the **obligation released**: this line's share of the base value the
  /// subject book gave up, at the rate that position was carried at. Where
  /// nothing was on the books to relieve, the movement is the origin of the
  /// value and this equals `transaction_base_amount`.
  settlement_base_amount   Decimal  @db.Decimal(18, 2)
  settlement_exchange_rate Decimal? @db.Decimal(18, 6)

  transaction_amount      Decimal @db.Decimal(18, 2)
  /// What the **cash cost**: this line's share of the base value that actually
  /// left the bank, at the layer's rate or the rate the bank converted at.
  transaction_base_amount Decimal @db.Decimal(18, 2)
  /// The line's FX result, signed as a gain: positive is a gain, negative a
  /// loss. On a line settling open items it is the **sum of its items'**
  /// differences, kept for reading only — each item's is journaled on a line of
  /// its own (`FinCashBankTransactionLineItem.fx_difference`), never netted.
  fx_difference           Decimal @default(0) @db.Decimal(18, 2)

  /// The open item this line opened, where it raised a subject-book position
  /// (`sub_ledger_balance.id`, a plain id). What lets a Budget follow the
  /// money past its own realization — a held receipt reclassified to the book
  /// it belongs in is found from here. Null where the line lowered a position,
  /// kept no book, or was posted before the column existed.
  opened_item_id Int?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  transaction     FinCashBankTransaction           @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  source_doc_type SysDocType                       @relation(fields: [source_doc_type_id], references: [id])
  /// The open items a line lowering a subject-book position settles, each for
  /// an amount the user chose. Empty where the line raises a position or its
  /// Budget Category keeps no book.
  items           FinCashBankTransactionLineItem[]

  @@unique([transaction_id, sequence_no])
  @@index([source_doc_type_id, source_doc_id])
  @@index([opened_item_id])
  @@map("fin_cash_bank_transaction_line")
}

/// One open item a Realisasi line settles, and for how much.
///
/// A line lowering a position — a Titipan returned, a Hutang paid, a Piutang
/// collected — may settle several items of its Budget's Partner at once. The
/// user picks each item and states each amount; nothing is distributed by the
/// system. The line's `settlement_amount` is the sum of its items.
///
/// Each item is relieved at **its own** kurs and has its own FX difference,
/// journaled on its own line: an item raised at 15.000 and one at 13.000,
/// settled with dollars costing 14.000, are a gain and a loss, and netting
/// them would hide both (IAS 21 / PSAK 10 recognise the difference per
/// monetary item settled, and SAP and Odoo keep it per cleared item).
model FinCashBankTransactionLineItem {
  id                    Int @id @default(autoincrement())
  line_id               Int
  sequence_no           Int
  /// The item adjusted (`sub_ledger_balance.id`). A plain id rather than a
  /// relation, like `cash_bank_layer_id`: the item belongs to the subject-book
  /// module.
  sub_ledger_balance_id Int

  /// In the document's currency; more than nil, never more than the item holds.
  amount                  Decimal @db.Decimal(18, 2)
  /// What the item released, at its own kurs. Written at Post.
  settlement_base_amount  Decimal @default(0) @db.Decimal(18, 2)
  /// This item's share of what the line's cash cost. Written at Post; the
  /// shares of a line add up to the line's `transaction_base_amount` exactly.
  transaction_base_amount Decimal @default(0) @db.Decimal(18, 2)
  /// Signed as a gain. Positive posts to the credit side, negative to the
  /// debit side, zero writes no journal line.
  fx_difference           Decimal @default(0) @db.Decimal(18, 2)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  line FinCashBankTransactionLine @relation(fields: [line_id], references: [id], onDelete: Cascade)

  @@unique([line_id, sub_ledger_balance_id])
  @@unique([line_id, sequence_no])
  @@index([sub_ledger_balance_id])
  @@map("fin_cash_bank_transaction_line_item")
}

/// The intercompany bridge: what the anak needs, and which resource of the
/// induk's answered it.
///
/// Raised by submitting an anak Cash Bank Transaction, which has no Cash & Bank
/// of its own to draw on (concept doc §26.2, §27). The induk confirms — it never
/// rejects and never funds partially, so request amount = document amount =
/// funded amount (§28, §29) — and that confirmation is the actual boundary for
/// **both** Companies: one atomic posting writes the induk's cash movement, both
/// Companies' subject books, a journal each, and the Budgets' realization (§30).
///
/// The DBML declares `requesting_company_id` and `treasury_provider_company_id`
/// here. Neither is stored. The requester is the document's own Company, the
/// provider is the `is_parent` Company resolved at runtime, and CLAUDE.md §14
/// forbids a `treasury_provider_company_id` column outright — with exactly two
/// permanent Companies, storing either would be duplicating configuration the
/// application already knows.
model FinFundingRequest {
  id                 Int    @id @default(autoincrement())
  funding_request_no String @unique

  request_date DateTime @db.Date

  /// The realization that needs treasury. One request per document (§28).
  transaction_id Int
  currency_id    Int

  /// The full amount of the document. There is no partial funding (§29).
  request_amount Decimal @db.Decimal(18, 2)

  /// Chosen by the provider at confirmation; null while the request is open.
  provider_cash_bank_id       Int?
  /// The rate layer the confirmation drew on, where foreign currency left a
  /// foreign resource. The layer is mutable, so the document that consumed it
  /// keeps which one — as `fin_cash_bank_transaction.cash_bank_layer_id` does.
  provider_cash_bank_layer_id Int?

  status FundingStatus @default(Open)
  note   String?

  confirmed_at DateTime? @db.Timestamptz(6)
  confirmed_by Int?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  transaction        FinCashBankTransaction @relation(fields: [transaction_id], references: [id])
  currency           RefCurrency            @relation(fields: [currency_id], references: [id])
  provider_cash_bank MCashBank?             @relation(fields: [provider_cash_bank_id], references: [id])

  @@index([status])
  @@index([transaction_id])
  @@map("fin_funding_request")
}

// ------------------------------------------------- cash bank transfer

/// How a transfer's two accounts relate, which is the whole of what a transfer
/// Purpose says. A transfer has no Budget Category, no Partner Category and
/// no Budget to realize: it moves the Company's own money between its own resources, so it
/// realizes no Budget, names no Partner and keeps no subject book.
///
/// The catalogue is `src/lib/siba/transfer-catalogue.ts`; this enum is stored so
/// a posted document still says what it was even if the catalogue is reworded.
enum TransferPurpose {
  /// Both resources hold the same currency. Base value is conserved and no
  /// difference can arise.
  Transfer
  /// Foreign out, base in — selling foreign currency. The **only** purpose that
  /// can produce an FX difference: what the layer released and what the bank
  /// actually credited are two independently determined base values.
  Pencairan
  /// Base out, foreign in — buying foreign currency. Origination: there is
  /// nothing on the books to disagree with, so no difference can arise.
  PembelianValas
}

/// A movement of the Company's own money between its own Cash & Bank resources.
///
/// The header names the **source** and the lines name the destinations, so one
/// document can split one withdrawal across several accounts. Its own module
/// and its own tables rather than a third `transaction_type` on
/// `fin_cash_bank_transaction`: a Cash Bank Transaction line settles a Budget,
/// a transfer line names a Cash & Bank, and the two documents share neither a
/// classification chain, a subject book, nor a realization.
///
/// Both Companies' charts are irrelevant here — the anak holds no Cash & Bank
/// by design (concept doc §25, §32), so every transfer is the induk's, and
/// `company_id` is derived from the source rather than picked.
///
/// **Base value is conserved** (CORE multi-currency §5.8, invariant 18) and
/// **layers propagate one-for-one** (SIBA multi-currency §6): three destination
/// lines out of one source layer create three destination layers, never one
/// blended one.
model FinCashBankTransfer {
  id              Int       @id @default(autoincrement())
  transfer_no     String    @unique
  /// Null until the document is posted — a Draft has moved nothing and so has
  /// no date, exactly as a Cash Bank Transaction has none.
  accounting_date DateTime? @db.Date
  posted_at       DateTime? @db.Timestamptz(6)

  /// The source resource's Company. Both legs belong to it: a movement between
  /// two Companies is the intercompany bridge, which is Funding Request's.
  company_id Int
  purpose    TransferPurpose

  /// The source. Money always leaves this resource.
  from_cash_bank_id Int

  /// The document currency: the foreign currency of the pair, or the shared
  /// currency where both sides hold the same one. Derived from the source for
  /// Transfer and Pencairan; chosen for Pembelian Valas, which is the one case
  /// where the source is rupiah and the currency being bought is the input.
  currency_id Int

  /// The source layer this document draws on, where the source holds foreign
  /// currency. One document, one layer — the same narrowing a Cash Bank
  /// Transaction takes, and for the same reason.
  cash_bank_layer_id Int?

  /// Total in the document currency, and what the source released in base.
  transfer_amount      Decimal @db.Decimal(18, 2)
  transfer_base_amount Decimal @db.Decimal(18, 2)

  note   String?
  status TransactionStatus @default(Draft)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  company        SysCompany  @relation(fields: [company_id], references: [id])
  currency       RefCurrency @relation(fields: [currency_id], references: [id])
  from_cash_bank MCashBank   @relation(fields: [from_cash_bank_id], references: [id])

  lines FinCashBankTransferLine[]

  @@index([company_id])
  @@index([status])
  @@map("fin_cash_bank_transfer")
}

/// One destination of a transfer: where part of the money lands, and what it
/// was worth on each side of the move.
///
/// Both faces are stored rather than derived. They are two independently
/// determined facts — what the source gave up and what the destination received
/// — and on a Pencairan they genuinely differ, which is the realized gain or
/// loss. Re-deriving either at a later rate would destroy the only figure that
/// says what the conversion actually cost (CLAUDE.md §12).
model FinCashBankTransferLine {
  id          Int @id @default(autoincrement())
  transfer_id Int
  sequence_no Int

  /// Where the money lands. Never the source, and never twice in one document.
  to_cash_bank_id Int

  /// In the **document** currency: the foreign amount on a cross-currency
  /// transfer, the shared amount otherwise.
  amount        Decimal @db.Decimal(18, 2)
  /// Document currency to base. Entered where the pair crosses — per line, so
  /// proceeds split across two accounts may carry the two rates the bank
  /// actually used. Read off the source layer or `1` otherwise.
  exchange_rate Decimal @db.Decimal(18, 6)

  /// What left the source, in the source resource's own currency, and the base
  /// value it released.
  out_amount      Decimal @db.Decimal(18, 2)
  out_base_amount Decimal @db.Decimal(18, 2)

  /// What arrived at the destination, in that resource's own currency, and the
  /// base value it received.
  in_amount      Decimal @db.Decimal(18, 2)
  in_base_amount Decimal @db.Decimal(18, 2)

  /// `in_base_amount − out_base_amount`. Non-zero only on a Pencairan, where
  /// the sale rate and the layer's carrying rate are two different figures.
  /// Positive is a gain on the credit side, negative a loss on the debit side,
  /// and zero writes no journal line at all.
  fx_difference Decimal @default(0) @db.Decimal(18, 2)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  transfer     FinCashBankTransfer @relation(fields: [transfer_id], references: [id], onDelete: Cascade)
  to_cash_bank MCashBank           @relation(fields: [to_cash_bank_id], references: [id])

  @@unique([transfer_id, sequence_no])
  @@index([to_cash_bank_id])
  @@map("fin_cash_bank_transfer_line")
}

// ---------------------------------------------------------------- pencairan open item

/// Pencairan Open Item: foreign currency sold out of a Cash & Bank, and the
/// Partner's own open items in that currency converted to base currency at the
/// **same** kurs, in one document.
///
/// The cash leg is a Pencairan — one foreign source, one layer, base-currency
/// destinations each at its own kurs. The Partner leg releases each chosen
/// foreign item at its own kurs and opens one base-currency item per line, in
/// the same book, for exactly what that line's sale produced. Because one kurs
/// values both legs, the only difference left is the gap between the cash
/// layer's kurs and the items' kurs, and it is journalled as **one** Selisih
/// Kurs line per document — a difference of the sale, not a revaluation.
///
/// Its own module rather than a fourth Transfer purpose: a transfer names no
/// Partner and writes no subject book (CLAUDE.md §10 rule 84), and this
/// document exists to do both. One book and one Partner per document.
model FinItemConversion {
  id              Int       @id @default(autoincrement())
  /// `POI-0001`.
  conversion_no   String    @unique
  /// Chosen on the draft, any day up to today; Post dates everything by it.
  accounting_date DateTime? @db.Date
  posted_at       DateTime? @db.Timestamptz(6)

  /// The source's Company, derived rather than picked.
  company_id         Int
  /// The foreign source. Money always leaves this resource.
  from_cash_bank_id  Int
  /// The source's own currency — the foreign side of the sale, and the
  /// currency of every item the document converts.
  currency_id        Int
  /// The source layer the sale draws on. One document, one layer.
  cash_bank_layer_id Int

  /// The book (a subject book is a Budget Category) and the Partner whose
  /// items are converted. One of each per document.
  budget_category_id Int
  partner_id         Int

  /// Total sold, in the document currency.
  conversion_amount      Decimal @db.Decimal(18, 2)
  /// What the source layer released for it. Provisional on a Draft; Post
  /// writes what the layer actually released.
  conversion_base_amount Decimal @db.Decimal(18, 2)
  /// The one Selisih Kurs figure, signed as a gain. Written at Post.
  fx_difference          Decimal @default(0) @db.Decimal(18, 2)

  note   String?
  status TransactionStatus @default(Draft)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  company         SysCompany        @relation(fields: [company_id], references: [id])
  from_cash_bank  MCashBank         @relation(fields: [from_cash_bank_id], references: [id])
  currency        RefCurrency       @relation(fields: [currency_id], references: [id])
  budget_category SysBudgetCategory @relation(fields: [budget_category_id], references: [id])
  partner         MPartner          @relation(fields: [partner_id], references: [id])

  lines FinItemConversionLine[]

  @@index([company_id])
  @@index([partner_id])
  @@index([status])
  @@map("fin_item_conversion")
}

/// One base-currency destination of the sale, and the items it converts.
///
/// The items a line names add up to exactly the line's foreign amount: the
/// Partner's money is what is being sold, so a line never mixes it with the
/// Company's own. The line opens one base-currency item for what the bank
/// paid, which is therefore exactly what the destination received.
model FinItemConversionLine {
  id            Int @id @default(autoincrement())
  conversion_id Int
  sequence_no   Int

  /// Where the base currency lands. Never twice in one document.
  to_cash_bank_id Int

  /// In the document currency.
  amount        Decimal @db.Decimal(18, 2)
  /// Document currency to base: the rate the bank bought at, and the rate the
  /// items are converted at. Always an input.
  exchange_rate Decimal @db.Decimal(18, 6)

  /// What the source layer released for this line. Written at Post.
  out_base_amount Decimal @default(0) @db.Decimal(18, 2)
  /// What arrived, in base currency — `amount × exchange_rate` — and the
  /// value of the base-currency item the line opens. Written at Post.
  in_amount       Decimal @default(0) @db.Decimal(18, 2)
  /// The base-currency item the line opened (`sub_ledger_balance.id`), a
  /// plain id like `cash_bank_layer_id`. Null until Post.
  opened_item_id  Int?

  /// The two halves of the line's difference, each signed as a gain: the cash
  /// sold above or below its layer's kurs, and the items converted at a kurs
  /// other than their own. The journal carries their sum, once per document.
  cash_fx_difference Decimal @default(0) @db.Decimal(18, 2)
  item_fx_difference Decimal @default(0) @db.Decimal(18, 2)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  conversion   FinItemConversion           @relation(fields: [conversion_id], references: [id], onDelete: Cascade)
  to_cash_bank MCashBank                   @relation(fields: [to_cash_bank_id], references: [id])
  items        FinItemConversionLineItem[]

  @@unique([conversion_id, sequence_no])
  @@index([to_cash_bank_id])
  @@map("fin_item_conversion_line")
}

/// One foreign open item a line converts, and for how much — chosen and
/// stated by the user, never distributed.
model FinItemConversionLineItem {
  id                    Int @id @default(autoincrement())
  line_id               Int
  sequence_no           Int
  /// The item converted (`sub_ledger_balance.id`). A plain id: the item
  /// belongs to the subject-book module.
  sub_ledger_balance_id Int

  /// In the document currency; more than nil, never more than the item holds.
  amount                 Decimal @db.Decimal(18, 2)
  /// What the item released at its own kurs. Written at Post.
  settlement_base_amount Decimal @default(0) @db.Decimal(18, 2)
  /// This item's share of the base-currency item the line opened. A line's
  /// shares add up to its `in_amount` exactly. Written at Post.
  converted_base_amount  Decimal @default(0) @db.Decimal(18, 2)
  /// Signed as a gain. Part of the document's one Selisih Kurs line.
  fx_difference          Decimal @default(0) @db.Decimal(18, 2)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  line FinItemConversionLine @relation(fields: [line_id], references: [id], onDelete: Cascade)

  @@unique([line_id, sub_ledger_balance_id])
  @@unique([line_id, sequence_no])
  @@index([sub_ledger_balance_id])
  @@map("fin_item_conversion_line_item")
}

// ---------------------------------------------------------------- reklasifikasi open item

/// Reklasifikasi Open Item: value moved out of one subject-book position and
/// into another — a different book, a different Partner, or both — with no
/// cash moving. The case it exists for is clearing a *Belum Teridentifikasi*
/// holding book once the money's real place is known; the mechanism is any
/// book to any book, because a category that names a Partner is all a book is.
///
/// The header names the **source** position: one book, one Partner, one
/// currency. Each line names a **target** — a category that keeps a book and a
/// Partner it admits — and the source items it moves. The target is posted as
/// if the original movement had been classified into it: a book running the
/// same way **opens** one item per source item, at that item's own kurs and
/// base, so no difference can arise; a book running the other way has items
/// **settled**, chosen and stated by the user, and each settled item states its
/// own FX difference on its own journal line.
///
/// It reclassifies **items in the books**, never a Budget: a Budget's
/// classification is final (CLAUDE.md §10 rule 26), and this is what lets the
/// money move on while the plan keeps saying what it said.
model FinItemReclass {
  id              Int       @id @default(autoincrement())
  /// `RKL-0001`.
  reclass_no      String    @unique
  /// Chosen on the draft, any day up to today; Post dates everything by it.
  accounting_date DateTime? @db.Date
  posted_at       DateTime? @db.Timestamptz(6)

  /// The source Partner's Company, derived rather than picked.
  company_id         Int
  /// The source book (a subject book is a Budget Category) and its Partner.
  budget_category_id Int
  partner_id         Int
  /// The source position's currency, and every target's. A reclassification
  /// never changes currency — that is a Pencairan Open Item.
  currency_id        Int

  /// Sum of the lines, in the document currency.
  reclass_amount      Decimal @db.Decimal(18, 2)
  /// What the source items released, in base. Written at Post.
  reclass_base_amount Decimal @default(0) @db.Decimal(18, 2)
  /// The sum of every settled target item's difference, signed as a gain.
  /// Informational: the journal carries each on its own line. Written at Post.
  fx_difference       Decimal @default(0) @db.Decimal(18, 2)

  note   String?
  status TransactionStatus @default(Draft)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  company         SysCompany        @relation(fields: [company_id], references: [id])
  budget_category SysBudgetCategory @relation("ReclassSource", fields: [budget_category_id], references: [id])
  partner         MPartner          @relation("ReclassSource", fields: [partner_id], references: [id])
  currency        RefCurrency       @relation(fields: [currency_id], references: [id])

  lines FinItemReclassLine[]

  @@index([company_id])
  @@index([partner_id])
  @@index([status])
  @@map("fin_item_reclass")
}

/// One target: where a part of the source goes, and which source items it
/// takes. A receipt can be split across lines — part Hutang, part Titipan.
model FinItemReclassLine {
  id          Int @id @default(autoincrement())
  reclass_id  Int
  sequence_no Int

  /// The target book and the Partner whose position it moves. Never the
  /// source position itself.
  target_budget_category_id Int
  target_partner_id         Int

  /// Why the value moved, in the user's words. Becomes the note on what the
  /// line writes; falls back to the source item's own note where empty.
  description String?

  /// The sum of the source items — the line has no amount of its own.
  amount               Decimal @db.Decimal(18, 2)
  /// What the source items released, in base. Written at Post.
  released_base_amount Decimal @default(0) @db.Decimal(18, 2)
  /// The sum of the line's settled target items' differences, signed as a
  /// gain. Zero where the target opens items. Written at Post.
  fx_difference        Decimal @default(0) @db.Decimal(18, 2)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  reclass         FinItemReclass             @relation(fields: [reclass_id], references: [id], onDelete: Cascade)
  target_category SysBudgetCategory          @relation("ReclassTarget", fields: [target_budget_category_id], references: [id])
  target_partner  MPartner                   @relation("ReclassTarget", fields: [target_partner_id], references: [id])
  sources         FinItemReclassLineSource[]
  targets         FinItemReclassLineTarget[]

  @@unique([reclass_id, sequence_no])
  @@index([target_partner_id])
  @@map("fin_item_reclass_line")
}

/// One source item a line moves, and for how much — chosen and stated by the
/// user, never distributed.
model FinItemReclassLineSource {
  id                    Int @id @default(autoincrement())
  line_id               Int
  sequence_no           Int
  /// The source item (`sub_ledger_balance.id`). A plain id: the item belongs to
  /// the subject-book module.
  sub_ledger_balance_id Int

  /// In the document currency; more than nil, never more than the item holds.
  amount               Decimal @db.Decimal(18, 2)
  /// What the item released at its own kurs. Written at Post.
  released_base_amount Decimal @default(0) @db.Decimal(18, 2)
  /// The target item this one became, where the target book opens items — the
  /// clearing link a reader follows from the held item to where it went. Null
  /// where the target's items are settled instead, and until Post.
  opened_item_id       Int?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  line FinItemReclassLine @relation(fields: [line_id], references: [id], onDelete: Cascade)

  @@unique([line_id, sub_ledger_balance_id])
  @@unique([line_id, sequence_no])
  @@index([sub_ledger_balance_id])
  @@index([opened_item_id])
  @@map("fin_item_reclass_line_source")
}

/// One target item a line settles, where the target book runs the other way
/// from the source — chosen and stated by the user. A line's target amounts add
/// up to its source amount exactly.
model FinItemReclassLineTarget {
  id                    Int @id @default(autoincrement())
  line_id               Int
  sequence_no           Int
  /// The target item settled (`sub_ledger_balance.id`).
  sub_ledger_balance_id Int

  /// In the document currency; more than nil, never more than the item holds.
  amount                 Decimal @db.Decimal(18, 2)
  /// This item's share of what the line's source items released. A line's
  /// shares add up to its `released_base_amount` exactly. Written at Post.
  allocated_base_amount  Decimal @default(0) @db.Decimal(18, 2)
  /// What the item released at its own kurs. Written at Post.
  settlement_base_amount Decimal @default(0) @db.Decimal(18, 2)
  /// Signed as a gain; journalled on a line of its own. Written at Post.
  fx_difference          Decimal @default(0) @db.Decimal(18, 2)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  line FinItemReclassLine @relation(fields: [line_id], references: [id], onDelete: Cascade)

  @@unique([line_id, sub_ledger_balance_id])
  @@unique([line_id, sequence_no])
  @@index([sub_ledger_balance_id])
  @@map("fin_item_reclass_line_target")
}

// ------------------------------------------------- penyesuaian open item

/// Which way one line moves its open item: Penambahan raises it, Pengurangan
/// lowers it — the way a Debit Note and a Credit Note move the invoice they
/// reference in mainstream ERP.
///
/// Never chosen: it is the sign of the line's difference, the new value the
/// user typed against what the item held when the draft was saved. Stated as
/// the effect rather than as a side of the Partner's account, so a line reads
/// the same in every book; which side of the journal that is follows from the
/// book's own `raises`, exactly as for a cash posting.
enum ItemAdjustmentEffect {
  Increase
  Decrease
}

/// Penyesuaian Open Item: the adjustment document for a Partner's position in
/// a subject book. No cash moves, so it writes no Cash Bank Book entry and
/// realizes no Budget. At Post it writes the subject-book entries and one
/// balanced journal in one transaction.
///
/// It changes **existing open items** of one position (book x Partner x
/// currency) and never opens one: SIBA keeps no invoice, so the item is what
/// the document references. Every line names one item and the value it should
/// now hold; the difference is posted as a new ledger line on that item, at
/// its own kurs, so no FX difference can arise and no kurs is typed. One
/// document may raise some items and lower others. `reference` carries the
/// counterparty's own document number where there is one.
///
/// The counter account is one of two Mapping Account System entries per
/// Company: Pendapatan Penyesuaian when it is credited, Beban Penyesuaian when
/// it is debited — which one is decided, line by line, by the side the Partner
/// line takes.
model FinItemAdjustment {
  id            Int    @id @default(autoincrement())
  /// `PYO-0001`. Documents posted as Debit / Credit Notes keep their `DN-` /
  /// `CN-` numbers.
  adjustment_no String @unique

  /// The day it belongs to in the books, chosen on the draft.
  accounting_date DateTime? @db.Date
  posted_at       DateTime? @db.Timestamptz(6)

  /// The Partner's Company, derived rather than picked.
  company_id         Int
  /// The book. A subject book is a Budget Category (CLAUDE.md §12), and only
  /// one carrying `allows_item_adjustment` may be adjusted.
  budget_category_id Int
  partner_id         Int
  currency_id        Int

  /// Null: every item moves at its own kurs. Documents posted while a raise
  /// opened a new item at a typed kurs keep the `1` they carried.
  exchange_rate Decimal? @db.Decimal(18, 6)

  /// The net change to the position, in its currency: what the lines raise
  /// less what they lower, so negative when the document lowers it on balance.
  adjustment_amount      Decimal @db.Decimal(18, 2)
  /// The same net change in base. Valued when the draft is saved and again at
  /// Post.
  adjustment_base_amount Decimal @default(0) @db.Decimal(18, 2)

  /// The counterparty's own document number, where there is one.
  reference String?
  note      String?
  status    TransactionStatus @default(Draft)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  company         SysCompany        @relation(fields: [company_id], references: [id])
  budget_category SysBudgetCategory @relation(fields: [budget_category_id], references: [id])
  partner         MPartner          @relation(fields: [partner_id], references: [id])
  currency        RefCurrency       @relation(fields: [currency_id], references: [id])

  lines FinItemAdjustmentLine[]

  @@index([company_id])
  @@index([partner_id])
  @@index([status])
  @@map("fin_item_adjustment")
}

/// One open item and the value it should now hold. The user types the new
/// value; the difference, its direction and its base are worked out when the
/// draft is saved and again at Post. Post refuses when the item no longer
/// holds `balance_before`, because a new value typed against another balance
/// would move it by a difference nobody saw.
model FinItemAdjustmentLine {
  id            Int    @id @default(autoincrement())
  adjustment_id Int
  sequence_no   Int
  /// Written by the system — "Penambahan USD 200,00 atas SBI-0012" — and read
  /// by the subject-book entry and the journal lines.
  description   String

  /// The item adjusted (`sub_ledger_balance.id`). A plain id rather than a
  /// relation: the item belongs to the subject-book module. Null only on
  /// documents posted while a raise opened a new item.
  sub_ledger_balance_id Int?
  /// Derived from the sign of the difference, never chosen.
  effect                ItemAdjustmentEffect
  /// What the item held when the draft was saved, and the value typed for it.
  /// Null on documents posted before a line was stated as a new value.
  balance_before        Decimal?             @db.Decimal(18, 2)
  new_amount            Decimal?             @db.Decimal(18, 2)

  /// The difference, unsigned — `effect` says which way — in the position's
  /// currency.
  amount      Decimal @db.Decimal(18, 2)
  /// What the difference is worth in base, at the item's own kurs.
  base_amount Decimal @default(0) @db.Decimal(18, 2)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  adjustment FinItemAdjustment @relation(fields: [adjustment_id], references: [id], onDelete: Cascade)

  @@unique([adjustment_id, sequence_no])
  @@index([sub_ledger_balance_id])
  @@map("fin_item_adjustment_line")
}

// ---------------------------------------------------------------- audit

/// One trail for every table. Referenced loosely by entity key and row id
/// rather than by FK, since it spans every table.
/// A journal produced by a business posting is `Posted` the moment it exists —
/// it is the record of something that has already happened. A **manual**
/// journal is typed by a person, so it is saved `Draft` first and reaches
/// `Posted` through the same posting engine; `Cancelled` retires a draft that
/// should not exist, since nothing in this application is deleted.
///
/// Only a `Posted` journal is accounting: the General Ledger, the Trial Balance
/// and every balance reader filter on it. See CLAUDE.md §12.
enum JournalStatus {
  Draft
  Posted
  Cancelled
}

/// Which ledger an account belongs to (Journal 2.0 D18). `none` touches no
/// ledger; `partner` needs a Partner for the breakdown only; `subject_book`
/// a Partner and an open item in its one book; `cash_bank` a Cash & Bank.
enum AccountLedger {
  none
  partner
  subject_book
  cash_bank
}

/// The accounting journal. A `Posted` journal is append-only and immutable:
/// once posted, a journal and its lines are never updated and never deleted. A
/// correction is a new journal, exactly as a corrected business transaction is
/// a new document.
///
/// A manual journal is editable while it is still `Draft`, and a draft is not
/// accounting — it moves nothing and no report can see it.
///
/// Only the General Ledger derives from these lines. The operational books —
/// the Cash Bank Book and the subject ledgers — are independent historical
/// stores written alongside the journal, never from it (§2.5).
model AccJournal {
  id                 Int           @id @default(autoincrement())
  journal_no         String        @unique
  /// The day the journal belongs to in the books — its document's date, which
  /// may be earlier than today (a backdated document) and never later. A
  /// manual draft carries the date it is meant for; every reader filters
  /// `status: "Posted"`, so a draft's date reaches no report. When the journal
  /// was posted is `posted_at`. Null only on a draft saved before drafts
  /// carried a date.
  accounting_date    DateTime?     @db.Date
  /// When Post ran. Null while a manual journal is a draft. `created_at` is
  /// audit only and is never read as a business date.
  posted_at          DateTime?     @default(dbgenerated("transaction_timestamp()")) @db.Timestamptz(6)
  /// What produced this journal, for traceability back to the document.
  source_doc_type_id Int?
  source_doc_id      Int?
  company_id         Int
  description        String
  status             JournalStatus @default(Posted)
  /// Typed by a person rather than produced by a document's posting. It is the
  /// only kind of journal that is ever a draft, the only one that is editable,
  /// and the only one whose accounts are narrowed by the control-account rule.
  is_manual          Boolean       @default(false)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  company         SysCompany         @relation(fields: [company_id], references: [id])
  source_doc_type SysDocType?        @relation(fields: [source_doc_type_id], references: [id])
  lines           AccJournalLine[]
  general_journal AccGeneralJournal?

  @@index([company_id, accounting_date])
  @@index([source_doc_type_id, source_doc_id])
  @@map("acc_journal")
}

/// One accounting entry. Exactly one of `debit_amount` / `kredit_amount`
/// carries the value and the other is zero; the two sides of a journal must
/// sum equal, which `postJournal` refuses to write without.
model AccJournalLine {
  id          Int @id @default(autoincrement())
  journal_id  Int
  sequence_no Int

  account_id Int
  partner_id Int?

  /// The line's own currency, which need not be the base one — and need not
  /// match the other lines of the same journal. A foreign document paid from a
  /// base-currency resource produces one journal holding both.
  currency_id   Int
  /// What `trx_amount` was worth: this line's currency to the base currency.
  /// `1` means the money is already base currency, and nothing else.
  exchange_rate Decimal @default(1) @db.Decimal(18, 6)

  /// **Base currency.** This is what the journal balances in, what the General
  /// Ledger reports, and what the Trial Balance totals — concept doc §11.2 and
  /// §16. Exactly one side carries value.
  debit_amount  Decimal @default(0) @db.Decimal(18, 2)
  kredit_amount Decimal @default(0) @db.Decimal(18, 2)
  /// The transaction-currency value of the entry, whichever side it fell on.
  /// Carried so a rupiah figure can be read back to the three hundred dollars
  /// that produced it; nothing is ever totalled in it.
  trx_amount    Decimal @db.Decimal(18, 2)

  description String

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  journal  AccJournal  @relation(fields: [journal_id], references: [id])
  account  AccAccount  @relation(fields: [account_id], references: [id])
  partner  MPartner?   @relation(fields: [partner_id], references: [id])
  currency RefCurrency @relation(fields: [currency_id], references: [id])

  @@index([journal_id])
  @@index([account_id])
  @@map("acc_journal_line")
}

/// Jurnal Umum (`JUM-`, Journal 2.0): a journal that may write any money
/// ledger. Every column of `acc_journal` under the same name and type, so it
/// can later replace that table without being reshaped (plan §6, §8). Post
/// writes an ordinary posted `acc_journal`, linked by `posted_journal_id`.
model AccGeneralJournal {
  id                 Int           @id @default(autoincrement())
  journal_no         String        @unique
  accounting_date    DateTime?     @db.Date
  /// Null while a draft, as on a manual journal; Post sets it.
  posted_at          DateTime?     @default(dbgenerated("transaction_timestamp()")) @db.Timestamptz(6)
  /// Null on a Jurnal Umum. Kept so that, once this table replaces
  /// acc_journal, every posting document writes its journal here.
  source_doc_type_id Int?
  source_doc_id      Int?
  company_id         Int
  description        String
  status             JournalStatus @default(Draft)
  is_manual          Boolean       @default(true)

  /// The journal Post wrote, while acc_journal is still the ledger.
  posted_journal_id Int? @unique

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  company         SysCompany              @relation(fields: [company_id], references: [id])
  source_doc_type SysDocType?             @relation(fields: [source_doc_type_id], references: [id])
  posted_journal  AccJournal?             @relation(fields: [posted_journal_id], references: [id])
  lines           AccGeneralJournalLine[]

  @@index([company_id, accounting_date])
  @@index([source_doc_type_id, source_doc_id])
  @@map("acc_general_journal")
}

/// A Jurnal Umum line: every column of `acc_journal_line`, plus the subject
/// its account's ledger demands. After Post its rows equal the posted
/// `acc_journal_line` rows one for one, the netted Selisih Kurs included.
model AccGeneralJournalLine {
  id          Int @id @default(autoincrement())
  journal_id  Int
  sequence_no Int

  /// Chosen first; it brings its ledger (`acc_account.ledger`).
  account_id Int
  partner_id Int?

  currency_id   Int
  /// 1 for the base currency; the subject's own kurs where it holds one; typed
  /// only for something new (D6, D19). Nothing records which.
  exchange_rate Decimal @default(1) @db.Decimal(18, 6)

  /// Base currency, exactly as Post writes them to acc_journal_line.
  debit_amount  Decimal @default(0) @db.Decimal(18, 2)
  kredit_amount Decimal @default(0) @db.Decimal(18, 2)
  trx_amount    Decimal @db.Decimal(18, 2)

  description String

  /// A weak reference read by the account's ledger adapter (D13): the open
  /// item (`sub_ledger_balance.id`, null for a new item) on a `subject_book`
  /// account, the Cash & Bank (`m_cash_bank.id`) on a `cash_bank` one.
  subject_id         Int?
  /// The rate layer a foreign Cash & Bank line draws on; the one extra
  /// reference a ledger is allowed (D19).
  cash_bank_layer_id Int?
  /// Saldo baru as typed (D14), and the balance it was typed against. Post
  /// refuses if the object no longer holds `balance_before`.
  new_value          Decimal? @db.Decimal(18, 2)
  balance_before     Decimal? @db.Decimal(18, 2)
  /// The one netted Selisih Kurs line (D7), written by the system on save.
  is_generated       Boolean  @default(false)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  journal         AccGeneralJournal @relation(fields: [journal_id], references: [id])
  account         AccAccount        @relation(fields: [account_id], references: [id])
  partner         MPartner?         @relation(fields: [partner_id], references: [id])
  currency        RefCurrency       @relation(fields: [currency_id], references: [id])
  cash_bank_layer CashBankLayer?    @relation(fields: [cash_bank_layer_id], references: [id])

  @@index([journal_id])
  @@index([account_id])
  @@index([account_id, subject_id])
  @@index([cash_bank_layer_id])
  @@map("acc_general_journal_line")
}

/// Every create, update and lifecycle transition in the application appends one
/// row here, and nothing ever updates or deletes one.
///
/// `action` is the coarse verb and `event` is the specific thing that
/// happened. The verb alone cannot answer what a history is opened for:
/// submit, approve, reject, post and confirm are all writes, so all of them
/// read as UPDATE. `event` carries the transition key the owning module's
/// workflow table already declares — "submit", "approve", "post" — and the
/// Indonesian label is read back from that table rather than stored here, so a
/// new lifecycle step is a row in a workflow table and not a migration.
///
/// It is nullable because rows written before the column existed genuinely do
/// not know which transition they were, and "Diubah" is the true answer for
/// them. See `lib/siba/audit-events.ts`.
model AuditLog {
  id         Int         @id @default(autoincrement())
  entity_key String
  row_id     Int
  action     AuditAction
  event      String?
  at         DateTime    @default(now()) @db.Timestamptz(6)
  by         Int

  @@index([entity_key, row_id])
  @@map("audit_log")
}

/// Revaluasi Kurs: one foreign Cash & Bank restated at a kurs the user states
/// (SIBA multi-currency §7, KB rate-layers 2.0). A document of its own, raised
/// by a user — never by a period close. Post closes every open layer of the
/// resource (`ClosedByRevaluation`), opens one layer holding the whole foreign
/// balance at the stated kurs, writes one base-only Cash Bank Book entry and
/// journals the difference against the Company's revaluation account.
///
/// It works on the layers **as they stand when it is posted**, never as they
/// stood on its date, and it is final: a wrong kurs is corrected by another
/// revaluation (CLAUDE.md §10 rule 24).
model FinCashBankRevaluation {
  id             Int    @id @default(autoincrement())
  /// `RVK-0001`.
  revaluation_no String @unique

  /// The day it belongs to in the books, chosen on the draft.
  accounting_date DateTime? @db.Date
  posted_at       DateTime? @db.Timestamptz(6)

  /// The resource's Company, derived rather than picked.
  company_id   Int
  cash_bank_id Int
  /// The resource's currency, derived. Never the base currency.
  currency_id  Int

  /// The kurs the user states as current — an input that creates base value.
  exchange_rate Decimal @db.Decimal(18, 6)

  /// What the resource holds, what it was carried at, and what it is carried
  /// at afterwards — valued when the draft is saved and again at Post.
  foreign_balance Decimal @default(0) @db.Decimal(18, 2)
  base_before     Decimal @default(0) @db.Decimal(18, 2)
  base_after      Decimal @default(0) @db.Decimal(18, 2)
  /// `base_after − base_before`: positive a gain, negative a loss.
  fx_difference   Decimal @default(0) @db.Decimal(18, 2)

  /// The layer Post opened (`cash_bank_layer.id`). A plain id: the layer
  /// belongs to the Cash Bank Book.
  opened_layer_id Int?

  note   String?
  status TransactionStatus @default(Draft)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  company   SysCompany  @relation(fields: [company_id], references: [id])
  cash_bank MCashBank   @relation(fields: [cash_bank_id], references: [id])
  currency  RefCurrency @relation(fields: [currency_id], references: [id])

  closed_layers FinCashBankRevaluationLayer[]

  @@index([company_id])
  @@index([cash_bank_id])
  @@index([status])
  @@map("fin_cash_bank_revaluation")
}

/// One layer a posted revaluation closed, as it stood when it was closed —
/// what the governance rule asks to be kept: which rates were given up, and
/// for how much. Written at Post only; a draft lists the layers live.
model FinCashBankRevaluationLayer {
  id                 Int @id @default(autoincrement())
  revaluation_id     Int
  sequence_no        Int
  /// `cash_bank_layer.id`, a plain id like every other layer reference.
  cash_bank_layer_id Int

  rate           Decimal @db.Decimal(18, 6)
  foreign_amount Decimal @db.Decimal(18, 2)
  base_amount    Decimal @db.Decimal(18, 2)

  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  revaluation FinCashBankRevaluation @relation(fields: [revaluation_id], references: [id])

  @@unique([cash_bank_layer_id])
  @@index([revaluation_id])
  @@map("fin_cash_bank_revaluation_layer")
}
