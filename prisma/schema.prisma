// SIBA 3.0 — Prisma schema
//
// Translated from `Initialization/SIBA 3.0 DBML.txt` (MySQL-flavoured DBML),
// which is reference material rather than gospel: where the application needs a
// column the DBML lacks, the column is added and the reason recorded here.
//
// Deliberate deviations from the source DBML:
//   * `datetime`            -> DateTime @db.Timestamptz(6)
//   * inline `enum(...)`    -> native Postgres enums
//   * `bigint` ids          -> Int (avoids BigInt serialization pain across the
//                             server/client boundary; ample for this domain)
//   * money `decimal(18,6)` -> Decimal(18,2). The DBML used (18,6) only on
//                             budget_amount / realized_amount; every other money
//                             column was (18,2). Treated as a typo. Exchange
//                             rates keep (18,6).
//   * created_by/updated_by stay plain Int with no FK, exactly as the DBML
//                             declares them (it defines no ref for these).
//
// Additions the application requires but the DBML lacks:
//   * SysUser                      — nothing in the DBML backs created_by/updated_by
//   * SysCompany.is_parent         — marks the single induk of the fixed
//                             two-company structure (one induk, one anak)
//   * AccAccount.partner_category_id       — one account holds one partner category
//   * AccBudgetCategoryAccount.partner_category_id — category x partner-category -> account
//   * AuditLog                     — one trail spanning every table
//   * SysRole / SysPermission / SysUserRole / SysRolePermission / SysSession
//                                  — authentication and RBAC; the DBML has no
//                             authentication model at all
//
// Dropped vs the DBML:
//   * AccAccount.partner_type — flagged `// diganti nanti` in the source and
//     superseded by partner_category_id.
//
// Not yet modelled (present in the DBML and/or the concept doc):
//   general_ledger and intercompany_event — both deliberately. The General
//   Ledger is derived from acc_journal_line rather than stored, and the
//   Funding Request is the intercompany identifier (CLAUDE.md §12).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Nested `include`s load in one SQL statement (LATERAL joins) instead of one
  // query per relation level. On the deployed Neon database every query is a
  // network round trip (shared KB engineering/code-conventions §6).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum ActiveStatus {
  Active
  Inactive
}

enum CashBankType {
  Cash
  Bank
}

enum NormalBalance {
  Debit
  Kredit
}

/// Which statement an account type belongs to, and therefore whether the
/// accounts beneath it are closed out at the end of a fiscal year.
///
/// Stored rather than read off the first segment of a lineage code. The
/// convention — `4` and `5` are Laba Rugi — happens to hold, and a
/// convention that merely happens to hold is one a future maintainer can break
/// with nothing failing. A column is a fact the database can be asked for.
enum AccountSection {
  BalanceSheet
  ProfitLoss
}

/// Which step of the multi-step Laba Rugi an Account Category sits in.
///
/// Declared in this order on purpose: it is the order the statement reads,
/// and each subtotal — Laba Kotor after HPP, Laba Usaha after Beban Usaha,
/// Laba Bersih after Beban Lain-lain — closes the steps above it. Stored on
/// the category rather than read off its number for the same reason `section`
/// is: `5.1` being HPP is a convention, and a convention that merely holds
/// can be broken with nothing failing.
enum ProfitLossGroup {
  OperatingRevenue
  CostOfSales
  OperatingExpense
  OtherIncome
  OtherExpense
}

enum FiscalStatus {
  Draft
  Open
  Closed
}

/// A fiscal period's state within its Company's calendar. `Open` accepts
/// postings; `Locked` refuses them and may be unlocked again — it is a state,
/// not a close; `Closed` is reached only when the year closes, and is final.
enum FiscalPeriodStatus {
  Open
  Locked
  Closed
}

/// Whether one Company has closed one fiscal year.
///
/// Deliberately not `FiscalStatus`: a closing has no Draft. A year is either
/// still receiving this Company's postings or it never will again.
enum FiscalClosingStatus {
  Open
  Closed
}

enum FlowDirection {
  In
  Out
}

/// `Approved` is the classification stage: an approver has said yes, and the
/// Budget waits in Klasifikasi Budget for its Category and Partner. Only
/// `Open` — classified — is realizable. `Rejected` is final, like `Cancelled`.
enum BudgetStatus {
  Draft
  Cancelled
  Submitted
  Rejected
  Approved
  Open
  Closed
}

/// `Pending` is the funded route: an anak document waits here while its
/// Funding Request is open. Like `Draft` it has moved nothing — the induk's
/// confirmation is what posts it (concept doc §29).
enum TransactionStatus {
  Draft
  Pending
  Posted
  Cancelled
}

/// A Funding Request stays open until the treasury provider confirms it, or
/// until the requesting Company withdraws the document that raised it. There is
/// no rejection: the provider always complies, so its action is a confirmation
/// rather than a decision (concept doc §29).
enum FundingStatus {
  Open
  Closed
  Cancelled
}

enum AuditAction {
  TAMBAH
  UPDATE
  HAPUS
}

// ---------------------------------------------------------------- auth & access
//
// RBAC: USER -> ROLE -> PERMISSION. A permission is one atomic capability; a
// role bundles permissions; a user holds roles. Roles are the only path to a
// permission — there is deliberately no direct user->permission grant, so the
// authorization model has exactly one source of truth.
//
// None of this is in the source DBML, which has no authentication model at all.

model SysUser {
  id            Int          @id @default(autoincrement())
  user_code     String       @unique
  /// The login identifier.
  email         String       @unique
  name          String
  initials      String
  /// bcrypt. Never selected into anything that crosses to a client component.
  password_hash String
  status        ActiveStatus @default(Active)

  /// Nullable, unlike the other masters: the bootstrap admin has no creator.
  created_by Int?
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  roles    SysUserRole[]
  sessions SysSession[]

  @@map("sys_user")
}

model SysRole {
  id         Int          @id @default(autoincrement())
  role_code  String       @unique
  /// Stable key referenced from application code (ADMIN, STAFF). Immutable on
  /// system roles, so `src/lib/siba/roles.ts` can rely on it.
  role_label String       @unique
  role_name  String
  /// Seeded roles. ADMIN is frozen: it always carries the whole catalogue and
  /// cannot be deactivated, which is what guarantees the application always has
  /// a way to administer users.
  is_system  Boolean      @default(false)
  note       String?
  status     ActiveStatus @default(Active)

  created_by Int?
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  users       SysUserRole[]
  permissions SysRolePermission[]

  @@map("sys_role")
}

/// Catalogue rows, owned by `src/lib/siba/permissions.ts` and synced by the
/// seed. Users never create or edit permissions, so this table carries no
/// status and no authorship — it is code, materialised for referential
/// integrity and for the role matrix to read names from.
model SysPermission {
  id              Int     @id @default(autoincrement())
  /// The stable code business logic asks for, e.g. `USER_CREATE`. Deliberately
  /// not a `<prefix>.<4 digits>` system code: nothing generates these.
  permission_code String  @unique
  permission_name String
  /// Grouping key, matching a nav module where one exists.
  module          String
  description     String?

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  roles SysRolePermission[]

  @@index([module])
  @@map("sys_permission")
}

/// System defaults — what the application prefills and assumes when the user
/// has not said otherwise. One row per setting key.
///
/// The catalogue of keys lives in code (`lib/siba/system-defaults.ts`), the way
/// the permission catalogue does: a setting is a branch in the code, so a row
/// nothing reads would be a setting nobody implemented. This table holds only
/// what each key is currently set to. Values are text because the catalogue
/// says how to read them — a `ref` setting stores a row id.
///
/// Not in the source DBML, which has no settings table at all.
model SysSetting {
  id            Int     @id @default(autoincrement())
  setting_key   String  @unique
  setting_value String?

  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("sys_setting")
}

/// Mapping Account System: the account one Company's posting engines post a
/// given role to — the intercompany bridge, Selisih Kurs, the Laba/Rugi equity
/// accounts, the Debit / Credit Note counter accounts. One row per Company and
/// role; `account_key` is a key of the catalogue in `system-accounts.ts`, and a
/// row whose key the catalogue no longer declares is ignored.
///
/// Its own table rather than keys in `sys_setting`: an application setting
/// prefills a control, while these decide where money is posted, belong to one
/// Company's chart, and are pointed at an account — so the foreign keys are
/// real rather than text that happens to hold an id.
model AccSystemAccount {
  id          Int    @id @default(autoincrement())
  company_id  Int
  account_key String
  account_id  Int?

  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  company SysCompany  @relation(fields: [company_id], references: [id])
  account AccAccount? @relation(fields: [account_id], references: [id])

  @@unique([company_id, account_key])
  @@map("acc_system_account")
}

/// A grant, not master data: revoking removes the row and writes an audit entry.
model SysUserRole {
  id      Int @id @default(autoincrement())
  user_id Int
  role_id Int

  created_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user SysUser @relation(fields: [user_id], references: [id])
  role SysRole @relation(fields: [role_id], references: [id])

  @@unique([user_id, role_id])
  @@index([user_id])
  @@map("sys_user_role")
}

/// A grant, not master data — same reasoning as SysUserRole.
model SysRolePermission {
  id            Int @id @default(autoincrement())
  role_id       Int
  permission_id Int

  created_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  role       SysRole       @relation(fields: [role_id], references: [id])
  permission SysPermission @relation(fields: [permission_id], references: [id])

  @@unique([role_id, permission_id])
  @@index([role_id])
  @@map("sys_role_permission")
}

/// Server-side sessions. The cookie carries an opaque random token; only its
/// SHA-256 is stored, so a database leak does not hand out live sessions.
/// Revocation is immediate because every request re-reads this row.
model SysSession {
  id           Int       @id @default(autoincrement())
  token_hash   String    @unique
  user_id      Int
  expires_at   DateTime  @db.Timestamptz(6)
  last_seen_at DateTime  @default(now()) @db.Timestamptz(6)
  /// Set on logout, on password change, and when the user is deactivated.
  revoked_at   DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  user SysUser @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([expires_at])
  @@map("sys_session")
}

// ---------------------------------------------------------------- sys

model SysCompany {
  id            Int     @id @default(autoincrement())
  company_code  String  @unique
  company_label String
  company_name  String
  /// Marks the induk of the fixed two-company structure. There are exactly two
  /// companies, permanently: one induk (is_parent = true) and one anak. This is
  /// foundational, not configuration — see CLAUDE.md §12. Company therefore has
  /// no write path in the application; identity changes go through the seed.
  /// Not in the DBML — added for concept v3.
  is_parent     Boolean @default(false)
  note          String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  partners         MPartner[]
  cash_banks       MCashBank[]
  accounts         AccAccount[]
  mappings         AccBudgetCategoryAccount[]
  budgets          BudBudget[]
  transactions     FinCashBankTransaction[]
  transfers        FinCashBankTransfer[]
  item_adjustments FinItemAdjustment[]
  conversions      FinItemConversion[]
  revaluations     FinCashBankRevaluation[]
  reclasses        FinItemReclass[]

  journals AccJournal[]

  fiscal_closings  AccFiscalClosing[]
  fiscal_years     AccFiscalYear[]
  fiscal_periods   AccFiscalPeriod[]
  opening_balances AccOpeningBalance[]
  system_accounts  AccSystemAccount[]
  general_journals AccGeneralJournal[]

  @@map("sys_company")
}

model SysAccountType {
  id             Int            @id @default(autoincrement())
  type_code      String         @unique
  type_label     String         @unique
  type_name      String
  /// Neraca or Laba Rugi. Seeded, never edited, never offered on a form: which
  /// statement a type belongs to is not a judgement call.
  section        AccountSection
  /// Which side the type's own total reads positive on — AKTIVA and BIAYA
  /// debit, PASIVA, EKUITAS and PENDAPATAN credit. The Neraca signs every row
  /// under a type by it, which is what prints Akumulasi Penyusutan (a Kredit
  /// account inside AKTIVA) as the deduction it is. Seeded, never edited, on no
  /// form; stored rather than read off the type's number for the reason
  /// `section` is.
  normal_balance NormalBalance
  note           String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  account_categories AccAccountCategory[]

  @@map("sys_account_type")
}

model SysDocType {
  id        Int     @id @default(autoincrement())
  doc_code  String  @unique
  doc_label String
  doc_name  String
  doc_table String
  note      String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  transaction_lines FinCashBankTransactionLine[]
  ledger_entries    CashBankLedger[]
  cash_bank_layers  CashBankLayer[]
  journals          AccJournal[]
  subledger_entries SubLedger[]
  general_journals  AccGeneralJournal[]

  @@map("sys_doc_type")
}

/// The classification a Budget is approved into, and the rules that classification
/// carries. `allows_in` / `allows_out` say which directions are meaningful for it —
/// balance-sheet logic, not cash direction — and `require_partner` says whether it
/// names a subject at all.
///
/// `require_partner = false` is a statement, not an absence: Asset and Biaya take no
/// Partner by design, which is a different fact from a category whose admitted
/// Partner Categories have simply not been configured yet. Without the flag an empty
/// `partner_categories` cannot tell the two apart.
model SysBudgetCategory {
  id             Int    @id @default(autoincrement())
  category_code  String @unique
  category_label String
  category_name  String

  /// Direction follows balance-sheet logic. Two booleans rather than an enum
  /// because the real answer is a set, and "Both" as a third enum value is a set
  /// pretending to be a scalar.
  allows_in       Boolean @default(false)
  allows_out      Boolean @default(false)
  /// False = this category names no Partner (Asset, Biaya). A mapping row is
  /// then refused rather than merely unused.
  require_partner Boolean @default(true)

  /// Which cash direction *raises* this category's subject position — the one
  /// fact a subject book needs that nothing else in the row predicts. Money out
  /// raises a Piutang and lowers a Hutang, which is balance-sheet logic rather
  /// than cash direction.
  ///
  /// Null where the category keeps no book. A category keeps one exactly when it
  /// names a Partner (§10 rule 52), so `require_partner` decides whether a book
  /// exists and this decides which way it runs.
  raises FlowDirection?

  /// Presentation for that book, both optional. The name, the subject line and
  /// whether the closing figure is a position or a running total are all derived
  /// from the row (see `subledger-catalogue.ts`); these two are the parts no
  /// derivation gets right. A new category is a usable book without them, and a
  /// better-worded one with them.
  book_icon              String?
  book_closing_label     String?
  /// Whether this category's subject book may be adjusted by a Penyesuaian
  /// Open Item. Stored rather than inferred: the counter account is one Profit
  /// & Loss account per side, which fixes a Titipan, a Hutang or a Piutang
  /// correctly and would book income or expense against owner drawings or an
  /// investment's own return. Only a category that keeps a book may carry it —
  /// `sys_budget_category_item_adjustment_needs_book` is the backstop.
  allows_item_adjustment Boolean @default(false)

  note   String?
  status ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  budgets            BudBudget[]
  mappings           AccBudgetCategoryAccount[]
  partner_categories SysBudgetPartnerCategoryMapping[]
  item_adjustments   FinItemAdjustment[]
  conversions        FinItemConversion[]
  reclasses          FinItemReclass[]                  @relation("ReclassSource")
  reclass_targets    FinItemReclassLine[]              @relation("ReclassTarget")
  sub_ledger_entries SubLedger[]
  sub_ledger_items   SubLedgerBalance[]
  ledger_accounts    AccAccount[]

  @@map("sys_budget_category")
}

model SysPartnerCategory {
  id             Int          @id @default(autoincrement())
  category_code  String       @unique
  category_label String
  category_name  String
  note           String?
  status         ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  partners          MPartner[]
  accounts          AccAccount[]
  mappings          AccBudgetCategoryAccount[]
  budget_categories SysBudgetPartnerCategoryMapping[]

  @@map("sys_partner_category")
}

/// Which Partner Categories a Budget Category admits — the chain
/// Budget Category -> Partner Category -> Partner, held as data rather than in code
/// so it can be reshaped through the GUI while the model is still being discovered.
///
/// One row per admitted pair, each carrying its own status, because narrowing a
/// category must not rewrite history: deactivating a pair stops it being offered on
/// new records and leaves every Budget already classified by it intact. That is the
/// whole reason this is a table of rows rather than a list held on the category.
model SysBudgetPartnerCategoryMapping {
  id                  Int    @id @default(autoincrement())
  mapping_code        String @unique
  budget_category_id  Int
  partner_category_id Int

  note   String?
  status ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  budget_category  SysBudgetCategory  @relation(fields: [budget_category_id], references: [id])
  partner_category SysPartnerCategory @relation(fields: [partner_category_id], references: [id])

  @@unique([budget_category_id, partner_category_id])
  @@index([partner_category_id])
  @@map("sys_budget_partner_category_mapping")
}

