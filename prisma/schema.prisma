// SIBA 3.0 — Prisma schema
//
// Translated from `Initialization/SIBA 3.0 DBML.txt` (MySQL-flavoured DBML),
// which is reference material rather than gospel: where the application needs a
// column the DBML lacks, the column is added and the reason recorded here.
//
// Deliberate deviations from the source DBML:
//   * `datetime`            -> DateTime @db.Timestamptz(6)
//   * inline `enum(...)`    -> native Postgres enums
//   * `bigint` ids          -> Int (avoids BigInt serialization pain across the
//                             server/client boundary; ample for this domain)
//   * money `decimal(18,6)` -> Decimal(18,2). The DBML used (18,6) only on
//                             budget_amount / realized_amount; every other money
//                             column was (18,2). Treated as a typo. Exchange
//                             rates keep (18,6).
//   * created_by/updated_by stay plain Int with no FK, exactly as the DBML
//                             declares them (it defines no ref for these).
//
// Additions the application requires but the DBML lacks:
//   * SysUser                      — nothing in the DBML backs created_by/updated_by
//   * SysCompany.is_parent         — marks the single induk of the fixed
//                             two-company structure (one induk, one anak)
//   * AccAccount.partner_category_id       — one account holds one partner category
//   * AccBudgetCategoryAccount.partner_category_id — category x partner-category -> account
//   * AuditLog                     — one trail spanning every table
//   * SysRole / SysPermission / SysUserRole / SysRolePermission / SysSession
//                                  — authentication and RBAC; the DBML has no
//                             authentication model at all
//
// Dropped vs the DBML:
//   * AccAccount.partner_type — flagged `// diganti nanti` in the source and
//     superseded by partner_category_id.
//
// Not yet modelled (present in the DBML and/or the concept doc):
//   acc_opening_balance(_line), acc_journal(_line), fin_funding_request, the
//   remaining operational books (prive / titipan / hutang / piutang ledgers),
//   general_ledger, intercompany_event.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum ActiveStatus {
  Active
  Inactive
}

enum CashBankType {
  Cash
  Bank
}

enum NormalBalance {
  Debit
  Kredit
}

enum FiscalStatus {
  Draft
  Open
  Closed
}

enum FlowDirection {
  In
  Out
}

enum BudgetStatus {
  Draft
  Cancelled
  Submitted
  Rejected
  Open
  Closed
}

/// `Pending` is the funded route: an anak document waits here while its
/// Funding Request is open. Like `Draft` it has moved nothing — the induk's
/// confirmation is what posts it (concept doc §29).
enum TransactionStatus {
  Draft
  Pending
  Posted
  Cancelled
}

/// A Funding Request stays open until the treasury provider confirms it, or
/// until the requesting Company withdraws the document that raised it. There is
/// no rejection: the provider always complies, so its action is a confirmation
/// rather than a decision (concept doc §29).
enum FundingStatus {
  Open
  Closed
  Cancelled
}

enum AuditAction {
  TAMBAH
  UPDATE
  HAPUS
}

// ---------------------------------------------------------------- auth & access
//
// RBAC: USER -> ROLE -> PERMISSION. A permission is one atomic capability; a
// role bundles permissions; a user holds roles. Roles are the only path to a
// permission — there is deliberately no direct user->permission grant, so the
// authorization model has exactly one source of truth.
//
// None of this is in the source DBML, which has no authentication model at all.

model SysUser {
  id            Int          @id @default(autoincrement())
  user_code     String       @unique
  /// The login identifier.
  email         String       @unique
  name          String
  initials      String
  /// bcrypt. Never selected into anything that crosses to a client component.
  password_hash String
  status        ActiveStatus @default(Active)

  /// Nullable, unlike the other masters: the bootstrap admin has no creator.
  created_by Int?
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  roles    SysUserRole[]
  sessions SysSession[]

  @@map("sys_user")
}

model SysRole {
  id         Int          @id @default(autoincrement())
  role_code  String       @unique
  /// Stable key referenced from application code (ADMIN, STAFF). Immutable on
  /// system roles, so `src/lib/siba/roles.ts` can rely on it.
  role_label String       @unique
  role_name  String
  /// Seeded roles. ADMIN is frozen: it always carries the whole catalogue and
  /// cannot be deactivated, which is what guarantees the application always has
  /// a way to administer users.
  is_system  Boolean      @default(false)
  note       String?
  status     ActiveStatus @default(Active)

  created_by Int?
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  users       SysUserRole[]
  permissions SysRolePermission[]

  @@map("sys_role")
}

/// Catalogue rows, owned by `src/lib/siba/permissions.ts` and synced by the
/// seed. Users never create or edit permissions, so this table carries no
/// status and no authorship — it is code, materialised for referential
/// integrity and for the role matrix to read names from.
model SysPermission {
  id              Int     @id @default(autoincrement())
  /// The stable code business logic asks for, e.g. `USER_CREATE`. Deliberately
  /// not a `<prefix>.<4 digits>` system code: nothing generates these.
  permission_code String  @unique
  permission_name String
  /// Grouping key, matching a nav module where one exists.
  module          String
  description     String?

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  roles SysRolePermission[]

  @@index([module])
  @@map("sys_permission")
}

/// System defaults — what the application prefills and assumes when the user
/// has not said otherwise. One row per setting key.
///
/// The catalogue of keys lives in code (`lib/siba/system-defaults.ts`), the way
/// the permission catalogue does: a setting is a branch in the code, so a row
/// nothing reads would be a setting nobody implemented. This table holds only
/// what each key is currently set to. Values are text because the catalogue
/// says how to read them — a `ref` setting stores a row id.
///
/// Not in the source DBML, which has no settings table at all.
model SysSetting {
  id            Int     @id @default(autoincrement())
  setting_key   String  @unique
  setting_value String?

  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("sys_setting")
}

/// A grant, not master data: revoking removes the row and writes an audit entry.
model SysUserRole {
  id      Int @id @default(autoincrement())
  user_id Int
  role_id Int

  created_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user SysUser @relation(fields: [user_id], references: [id])
  role SysRole @relation(fields: [role_id], references: [id])

  @@unique([user_id, role_id])
  @@index([user_id])
  @@map("sys_user_role")
}

/// A grant, not master data — same reasoning as SysUserRole.
model SysRolePermission {
  id            Int @id @default(autoincrement())
  role_id       Int
  permission_id Int

  created_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  role       SysRole       @relation(fields: [role_id], references: [id])
  permission SysPermission @relation(fields: [permission_id], references: [id])

  @@unique([role_id, permission_id])
  @@index([role_id])
  @@map("sys_role_permission")
}

/// Server-side sessions. The cookie carries an opaque random token; only its
/// SHA-256 is stored, so a database leak does not hand out live sessions.
/// Revocation is immediate because every request re-reads this row.
model SysSession {
  id           Int       @id @default(autoincrement())
  token_hash   String    @unique
  user_id      Int
  expires_at   DateTime  @db.Timestamptz(6)
  last_seen_at DateTime  @default(now()) @db.Timestamptz(6)
  /// Set on logout, on password change, and when the user is deactivated.
  revoked_at   DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  user SysUser @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([expires_at])
  @@map("sys_session")
}

// ---------------------------------------------------------------- sys

model SysCompany {
  id            Int     @id @default(autoincrement())
  company_code  String  @unique
  company_label String
  company_name  String
  /// Marks the induk of the fixed two-company structure. There are exactly two
  /// companies, permanently: one induk (is_parent = true) and one anak. This is
  /// foundational, not configuration — see CLAUDE.md §12. Company therefore has
  /// no write path in the application; identity changes go through the seed.
  /// Not in the DBML — added for concept v3.
  is_parent     Boolean @default(false)
  note          String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  partners     MPartner[]
  cash_banks   MCashBank[]
  accounts     AccAccount[]
  mappings     AccBudgetCategoryAccount[]
  budgets      BudBudget[]
  transactions FinCashBankTransaction[]

  journals AccJournal[]

  @@map("sys_company")
}

model SysAccountType {
  id         Int     @id @default(autoincrement())
  type_code  String  @unique
  type_label String  @unique
  type_name  String
  note       String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  account_categories AccAccountCategory[]

  @@map("sys_account_type")
}

model SysDocType {
  id        Int     @id @default(autoincrement())
  doc_code  String  @unique
  doc_label String
  doc_name  String
  doc_table String
  note      String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  transaction_lines FinCashBankTransactionLine[]
  ledger_entries    CashBankLedger[]
  journals          AccJournal[]
  subledger_entries SubLedger[]

  @@map("sys_doc_type")
}

model SysBudgetCategory {
  id             Int     @id @default(autoincrement())
  category_code  String  @unique
  category_label String
  category_name  String
  note           String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  budgets  BudBudget[]
  mappings AccBudgetCategoryAccount[]

  @@map("sys_budget_category")
}

model SysPartnerCategory {
  id             Int     @id @default(autoincrement())
  category_code  String  @unique
  category_label String
  category_name  String
  note           String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  partners MPartner[]
  accounts AccAccount[]
  mappings AccBudgetCategoryAccount[]

  @@map("sys_partner_category")
}

// ---------------------------------------------------------------- ref

model RefCurrency {
  id             Int          @id @default(autoincrement())
  currency_code  String       @unique
  currency_label String
  currency_name  String
  note           String?
  status         ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  cash_banks         MCashBank[]
  budgets            BudBudget[]
  transactions       FinCashBankTransaction[]
  journal_lines      AccJournalLine[]
  subledger_entries  SubLedger[]
  subledger_balances SubLedgerBalance[]
  funding_requests   FinFundingRequest[]

  @@map("ref_currency")
}

// ---------------------------------------------------------------- master

model MPartner {
  id            Int          @id @default(autoincrement())
  partner_code  String       @unique
  partner_label String
  partner_name  String
  company_id    Int
  category_id   Int
  note          String?
  status        ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  company  SysCompany         @relation(fields: [company_id], references: [id])
  category SysPartnerCategory @relation(fields: [category_id], references: [id])

  budgets            BudBudget[]
  transactions       FinCashBankTransaction[]
  journal_lines      AccJournalLine[]
  subledger_entries  SubLedger[]
  subledger_balances SubLedgerBalance[]

  @@index([company_id])
  @@index([category_id])
  @@map("m_partner")
}

model MCashBank {
  id              Int          @id @default(autoincrement())
  cash_bank_code  String       @unique
  cash_bank_label String
  cash_bank_name  String
  company_id      Int
  cash_bank_type  CashBankType
  currency_id     Int
  account_id      Int
  note            String?
  status          ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  company  SysCompany  @relation(fields: [company_id], references: [id])
  currency RefCurrency @relation(fields: [currency_id], references: [id])
  account  AccAccount  @relation(fields: [account_id], references: [id])

  transactions     FinCashBankTransaction[]
  ledger           CashBankLedger[]
  book_balance     CashBankBalance?
  funding_requests FinFundingRequest[]

  @@index([company_id])
  @@map("m_cash_bank")
}

// ---------------------------------------------------------------- cash bank book
//
// The Cash Bank Book: an independent, append-only record of every movement
// through a cash or bank resource, plus the balance it adds up to.
//
// `cash_bank_ledger` is the truth. Entries are never edited and never deleted —
// a mistake is corrected by a further entry, which is what makes the book
// auditable. `cash_bank_balance` is a materialised running total kept in step
// inside the same transaction as the entry that moved it, so reading a balance
// costs one row instead of a scan.
//
// The concept doc requires this book to stay independent of the journal: it is
// never a view over journal lines. Only the General Ledger derives from
// journals.

enum CashBankEntryType {
  /// The balance a resource starts with, written once when it is registered.
  Opening
  /// A posted cash/bank transaction.
  Transaction
  /// A manual correction, recorded rather than edited into an existing entry.
  Adjustment
}

model CashBankLedger {
  id           Int               @id @default(autoincrement())
  entry_no     String            @unique
  cash_bank_id Int
  entry_date   DateTime          @db.Date
  entry_type   CashBankEntryType
  direction    FlowDirection

  /// Always positive; `direction` carries the sign.
  amount        Decimal @db.Decimal(18, 2)
  /// The same figure, signed: +In, -Out. Summing this column reconstructs the
  /// balance from scratch, which is how the materialised total is verified.
  movement      Decimal @db.Decimal(18, 2)
  /// Balance after this entry, in the resource's own currency.
  balance_after Decimal @db.Decimal(18, 2)

  /// What caused the movement. Null for an opening balance, which has no
  /// source document — the registration of the resource is the event.
  source_doc_type_id Int?
  source_doc_id      Int?

  note String?

  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  cash_bank       MCashBank   @relation(fields: [cash_bank_id], references: [id])
  source_doc_type SysDocType? @relation(fields: [source_doc_type_id], references: [id])

  @@index([cash_bank_id, entry_date])
  @@index([source_doc_type_id, source_doc_id])
  @@map("cash_bank_ledger")
}

/// One row per cash/bank resource, derived from `cash_bank_ledger` and written
/// in the same transaction as the entry that changed it. Never written on its
/// own: `rebuildCashBankBalance` recomputes it from the ledger.
model CashBankBalance {
  cash_bank_id    Int       @id
  balance         Decimal   @default(0) @db.Decimal(18, 2)
  entry_count     Int       @default(0)
  last_entry_id   Int?
  last_entry_date DateTime? @db.Date

  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  cash_bank MCashBank @relation(fields: [cash_bank_id], references: [id])

  @@map("cash_bank_balance")
}

// ----------------------------------------------------------------- subledger

/// An entry in a subledger, which is what a `CashBankEntryType` is to the Cash
/// Bank Book. Its own enum rather than a shared one: a module that is meant to
/// be liftable does not take its types from another module's table.
enum SubLedgerEntryType {
  /// A subject's position before the application started keeping its book.
  /// Nothing writes one yet — it arrives with Opening Balance.
  Opening
  /// A posted Cash Bank Transaction.
  Transaction
  /// A manual correction, recorded rather than edited into an existing entry.
  Adjustment
}

/// The subject books — Titipan, Hutang, Piutang, Prive, Investasi and Hasil
/// Investasi — in one append-only table, keyed by `book`.
///
/// The subject is a **Partner** (concept doc §11.3-§11.6, §12), and every
/// entry is written straight from the business transaction at Post, alongside
/// the Cash Bank Book and the Journal. It is never derived from a journal
/// line: an operational book is an independent historical store, and only the
/// General Ledger reads the journal (§13, §14).
///
/// One table with a `book` discriminator rather than six identical tables. The
/// books differ only in which cash direction raises their subject's position,
/// which is a catalogue entry in `lib/siba/subledger-catalogue.ts` — six tables
/// would be six copies of one shape, and adding the seventh would be a
/// migration instead of a line of config.
///
/// `book` is a catalogue key (`hutang`), not a foreign key to
/// `sys_budget_category`. The book is meant to be liftable, and its own subject
/// is the Partner; tying every row to a reference table it does not otherwise
/// need would make it depend on the classification module to be read.
model SubLedger {
  id          Int                @id @default(autoincrement())
  entry_no    String             @unique
  /// Catalogue key from `lib/siba/subledger-catalogue.ts`.
  book        String
  partner_id  Int
  currency_id Int
  entry_date  DateTime           @db.Date
  entry_type  SubLedgerEntryType
  /// The direction the **money** moved, exactly as the document recorded it.
  direction   FlowDirection

  /// Always positive; `direction` and the book's own nature carry the sign.
  amount        Decimal @db.Decimal(18, 2)
  /// The same figure signed in the **book's** direction: positive where the
  /// entry raises the subject's position, negative where it lowers it. Summing
  /// this column reconstructs the balance, which is how the total is verified.
  movement      Decimal @db.Decimal(18, 2)
  /// The subject's position after this entry, in its own currency.
  balance_after Decimal @db.Decimal(18, 2)

  /// What caused the movement, as the weak document pair every book uses.
  source_doc_type_id Int?
  source_doc_id      Int?

  note String?

  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  partner         MPartner    @relation(fields: [partner_id], references: [id])
  currency        RefCurrency @relation(fields: [currency_id], references: [id])
  source_doc_type SysDocType? @relation(fields: [source_doc_type_id], references: [id])

  @@index([book, partner_id, entry_date])
  @@index([source_doc_type_id, source_doc_id])
  @@map("sub_ledger")
}

/// One row per subject and currency, derived from `sub_ledger` and written in
/// the same transaction as the entry that changed it. Never written on its own:
/// `rebuildSubledgerBalance` recomputes it from the entries.
///
/// Currency is part of the key because amounts are never converted (§12): a
/// Partner owing IDR and USD holds two positions, not one blended figure.
model SubLedgerBalance {
  id          Int    @id @default(autoincrement())
  book        String
  partner_id  Int
  currency_id Int

  balance         Decimal   @default(0) @db.Decimal(18, 2)
  entry_count     Int       @default(0)
  last_entry_id   Int?
  last_entry_date DateTime? @db.Date

  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  partner  MPartner    @relation(fields: [partner_id], references: [id])
  currency RefCurrency @relation(fields: [currency_id], references: [id])

  @@unique([book, partner_id, currency_id])
  @@index([book])
  @@map("sub_ledger_balance")
}

// ---------------------------------------------------------------- accounting

model AccAccountCategory {
  id              Int          @id @default(autoincrement())
  account_type_id Int
  category_code   String       @unique
  /// The category's place in the chart of accounts: its account type's code
  /// plus one segment, e.g. `1.1` under type `1`. Not in the DBML, which
  /// carried no numbering scheme — see lib/siba/account-code.ts.
  category_label  String       @unique
  category_name   String
  note            String?
  status          ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  account_type  SysAccountType          @relation(fields: [account_type_id], references: [id])
  subcategories AccAccountSubcategory[]

  @@index([account_type_id])
  @@map("acc_account_category")
}

model AccAccountSubcategory {
  id                  Int          @id @default(autoincrement())
  account_category_id Int
  subcategory_code    String       @unique
  /// Its category's code plus one segment, e.g. `1.1.1`. Every account
  /// number starts from one of these, so it is unique across the chart.
  subcategory_label   String       @unique
  subcategory_name    String
  note                String?
  status              ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  account_category AccAccountCategory @relation(fields: [account_category_id], references: [id])
  accounts         AccAccount[]

  @@index([account_category_id])
  @@map("acc_account_subcategory")
}

model AccAccount {
  id                     Int           @id @default(autoincrement())
  account_subcategory_id Int
  account_code           String        @unique
  /// The account number, continuing whatever the account hangs under: its
  /// subcategory's code (`1.1.1` -> `1.1.1.2`) or its parent account's
  /// (`1.1.1.2` -> `1.1.1.2.1`). Unique within a company — see @@unique
  /// below. The DBML only constrained the generated account_code globally.
  account_label          String
  account_name           String
  company_id             Int
  parent_account         Int?
  is_postable            Boolean       @default(true)
  normal_balance         NormalBalance
  require_partner        Boolean       @default(false)
  /// Not in the DBML. Locks a subledger account to a single partner category so
  /// subject histories never mix. Replaces the DBML's `partner_type`.
  partner_category_id    Int?
  is_control_account     Boolean       @default(false)
  note                   String?
  is_active              Boolean       @default(true)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  account_subcategory AccAccountSubcategory @relation(fields: [account_subcategory_id], references: [id])
  company             SysCompany            @relation(fields: [company_id], references: [id])
  partner_category    SysPartnerCategory?   @relation(fields: [partner_category_id], references: [id])
  parent              AccAccount?           @relation("AccountTree", fields: [parent_account], references: [id])
  children            AccAccount[]          @relation("AccountTree")

  cash_banks    MCashBank[]
  mappings      AccBudgetCategoryAccount[]
  journal_lines AccJournalLine[]

  @@unique([company_id, account_label])
  @@index([company_id])
  @@index([account_subcategory_id])
  @@map("acc_account")
}

model AccBudgetCategoryAccount {
  id                  Int    @id @default(autoincrement())
  bca_code            String @unique
  budget_category_id  Int
  company_id          Int
  /// Not in the DBML. Without it a single budget category cannot resolve to a
  /// different account per partner category.
  partner_category_id Int?
  account_id          Int

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  budget_category  SysBudgetCategory   @relation(fields: [budget_category_id], references: [id])
  company          SysCompany          @relation(fields: [company_id], references: [id])
  partner_category SysPartnerCategory? @relation(fields: [partner_category_id], references: [id])
  account          AccAccount          @relation(fields: [account_id], references: [id])

  @@unique([company_id, budget_category_id, partner_category_id])
  @@index([company_id])
  @@map("acc_budget_category_account")
}

model AccFiscalYear {
  id         Int          @id @default(autoincrement())
  year_code  String       @unique
  year_label String
  year_name  String
  start_date DateTime     @db.Date
  end_date   DateTime     @db.Date
  note       String?
  status     FiscalStatus @default(Draft)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  periods AccFiscalPeriod[]

  @@map("acc_fiscal_year")
}

model AccFiscalPeriod {
  id             Int          @id @default(autoincrement())
  fiscal_year_id Int
  sequence_no    Int
  period_code    String       @unique
  period_label   String
  period_name    String
  start_date     DateTime     @db.Date
  end_date       DateTime     @db.Date
  note           String?
  status         FiscalStatus @default(Draft)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  fiscal_year AccFiscalYear @relation(fields: [fiscal_year_id], references: [id])

  @@index([fiscal_year_id])
  @@map("acc_fiscal_period")
}

// ---------------------------------------------------------------- budget

model BudBudget {
  id              Int           @id @default(autoincrement())
  budget_no       String        @unique
  budget_date     DateTime      @db.Date
  company_id      Int
  currency_id     Int
  budget_type     FlowDirection
  /// Both stay null until an approver classifies the budget.
  category_id     Int?
  partner_id      Int?
  description     String
  budget_amount   Decimal       @db.Decimal(18, 2)
  realized_amount Decimal       @default(0) @db.Decimal(18, 2)
  status          BudgetStatus  @default(Draft)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  company  SysCompany         @relation(fields: [company_id], references: [id])
  currency RefCurrency        @relation(fields: [currency_id], references: [id])
  category SysBudgetCategory? @relation(fields: [category_id], references: [id])
  partner  MPartner?          @relation(fields: [partner_id], references: [id])

  @@index([company_id])
  @@index([status])
  @@index([budget_date])
  @@map("bud_budget")
}

// ---------------------------------------------------------------- finance

model FinCashBankTransaction {
  id               Int           @id @default(autoincrement())
  transaction_no   String        @unique
  /// Null until the document is posted. The DBML declared this NOT NULL, but a
  /// document only acquires a date when the money actually moves.
  document_date    DateTime?     @db.Date
  posting_date     DateTime?     @db.Timestamptz(6)
  transaction_type FlowDirection
  company_id       Int
  /// Purpose key (e.g. `PRV_SH_OUT`), resolved in `src/lib/siba/rules.ts`. A
  /// purpose carries behaviour a config table cannot express, so it stays
  /// application logic — CLAUDE.md §12 rejects a `fin_purpose` table.
  purpose          String
  cash_bank_id     Int?
  currency_id      Int
  exchange_rate    Decimal       @default(1) @db.Decimal(18, 6)
  partner_id       Int?

  transaction_amount      Decimal @db.Decimal(18, 2)
  transaction_base_amount Decimal @db.Decimal(18, 2)

  note   String?
  status TransactionStatus @default(Draft)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  company   SysCompany  @relation(fields: [company_id], references: [id])
  currency  RefCurrency @relation(fields: [currency_id], references: [id])
  cash_bank MCashBank?  @relation(fields: [cash_bank_id], references: [id])
  partner   MPartner?   @relation(fields: [partner_id], references: [id])

  lines            FinCashBankTransactionLine[]
  funding_requests FinFundingRequest[]

  @@index([company_id])
  @@index([status])
  @@map("fin_cash_bank_transaction")
}

model FinCashBankTransactionLine {
  id             Int @id @default(autoincrement())
  transaction_id Int
  sequence_no    Int

  /// Deliberately generic so a line can settle any document type. V1 only ever
  /// uses doc type = Budget.
  source_doc_type_id Int
  source_doc_id      Int

  /// Snapshot of what was settleable at the time, in the source currency.
  outstanding_amount Decimal @db.Decimal(18, 2)

  settlement_amount        Decimal  @db.Decimal(18, 2)
  settlement_base_amount   Decimal  @db.Decimal(18, 2)
  settlement_exchange_rate Decimal? @db.Decimal(18, 6)

  transaction_amount      Decimal @db.Decimal(18, 2)
  transaction_base_amount Decimal @db.Decimal(18, 2)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  transaction     FinCashBankTransaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  source_doc_type SysDocType             @relation(fields: [source_doc_type_id], references: [id])

  @@unique([transaction_id, sequence_no])
  @@index([source_doc_type_id, source_doc_id])
  @@map("fin_cash_bank_transaction_line")
}

/// The intercompany bridge: what the anak needs, and which resource of the
/// induk's answered it.
///
/// Raised by submitting an anak Cash Bank Transaction, which has no Cash & Bank
/// of its own to draw on (concept doc §26.2, §27). The induk confirms — it never
/// rejects and never funds partially, so request amount = document amount =
/// funded amount (§28, §29) — and that confirmation is the actual boundary for
/// **both** Companies: one atomic posting writes the induk's cash movement, both
/// Companies' subject books, a journal each, and the Budgets' realization (§30).
///
/// The DBML declares `requesting_company_id` and `treasury_provider_company_id`
/// here. Neither is stored. The requester is the document's own Company, the
/// provider is the `is_parent` Company resolved at runtime, and CLAUDE.md §14
/// forbids a `treasury_provider_company_id` column outright — with exactly two
/// permanent Companies, storing either would be duplicating configuration the
/// application already knows.
model FinFundingRequest {
  id                 Int    @id @default(autoincrement())
  funding_request_no String @unique

  request_date DateTime @db.Date

  /// The realization that needs treasury. One request per document (§28).
  transaction_id Int
  currency_id    Int

  /// The full amount of the document. There is no partial funding (§29).
  request_amount Decimal @db.Decimal(18, 2)

  /// Chosen by the provider at confirmation; null while the request is open.
  provider_cash_bank_id Int?

  status FundingStatus @default(Open)
  note   String?

  confirmed_at DateTime? @db.Timestamptz(6)
  confirmed_by Int?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  transaction        FinCashBankTransaction @relation(fields: [transaction_id], references: [id])
  currency           RefCurrency            @relation(fields: [currency_id], references: [id])
  provider_cash_bank MCashBank?             @relation(fields: [provider_cash_bank_id], references: [id])

  @@index([status])
  @@index([transaction_id])
  @@map("fin_funding_request")
}

// ---------------------------------------------------------------- audit

/// One trail for every table. Referenced loosely by entity key and row id
/// rather than by FK, since it spans every table.
/// Every journal this application writes is Posted the moment it exists: a
/// journal is *produced by* a posting, never drafted towards one. `Draft` is
/// carried because the DBML declares it and a future import path might stage
/// one, but nothing in the application writes it — see CLAUDE.md §12.
enum JournalStatus {
  Draft
  Posted
}

/// The accounting journal. Append-only and immutable: once written, a journal
/// and its lines are never updated and never deleted. A correction is a new
/// journal, exactly as a corrected business transaction is a new document.
///
/// Only the General Ledger derives from these lines. The operational books —
/// the Cash Bank Book today, the subject ledgers later — are independent
/// historical stores written alongside the journal, never from it (§2.5).
model AccJournal {
  id                 Int           @id @default(autoincrement())
  journal_no         String        @unique
  /// The day the journal was posted. Never back-dated: a journal records when
  /// the books were written, which is the moment the posting happened.
  posting_date       DateTime      @db.Date
  /// What produced this journal, for traceability back to the document.
  source_doc_type_id Int?
  source_doc_id      Int?
  company_id         Int
  description        String
  status             JournalStatus @default(Posted)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  company         SysCompany       @relation(fields: [company_id], references: [id])
  source_doc_type SysDocType?      @relation(fields: [source_doc_type_id], references: [id])
  lines           AccJournalLine[]

  @@index([company_id, posting_date])
  @@index([source_doc_type_id, source_doc_id])
  @@map("acc_journal")
}

/// One accounting entry. Exactly one of `debit_amount` / `kredit_amount`
/// carries the value and the other is zero; the two sides of a journal must
/// sum equal, which `postJournal` refuses to write without.
model AccJournalLine {
  id          Int @id @default(autoincrement())
  journal_id  Int
  sequence_no Int

  account_id Int
  partner_id Int?

  currency_id   Int
  /// The identity until a real exchange-rate source exists (§12). Nothing
  /// reads it; it is here because the schema carries what that source fills.
  exchange_rate Decimal @default(1) @db.Decimal(18, 6)

  debit_amount  Decimal @default(0) @db.Decimal(18, 2)
  kredit_amount Decimal @default(0) @db.Decimal(18, 2)
  /// The transaction-currency value of the entry, whichever side it fell on.
  trx_amount    Decimal @db.Decimal(18, 2)

  description String

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  journal  AccJournal  @relation(fields: [journal_id], references: [id])
  account  AccAccount  @relation(fields: [account_id], references: [id])
  partner  MPartner?   @relation(fields: [partner_id], references: [id])
  currency RefCurrency @relation(fields: [currency_id], references: [id])

  @@index([journal_id])
  @@index([account_id])
  @@map("acc_journal_line")
}

/// Every create, update and lifecycle transition in the application appends one
/// row here, and nothing ever updates or deletes one.
///
/// `action` is the coarse verb and `event` is the specific thing that
/// happened. The verb alone cannot answer what a history is opened for:
/// submit, approve, reject, post and confirm are all writes, so all of them
/// read as UPDATE. `event` carries the transition key the owning module's
/// workflow table already declares — "submit", "approve", "post" — and the
/// Indonesian label is read back from that table rather than stored here, so a
/// new lifecycle step is a row in a workflow table and not a migration.
///
/// It is nullable because rows written before the column existed genuinely do
/// not know which transition they were, and "Diubah" is the true answer for
/// them. See `lib/siba/audit-events.ts`.
model AuditLog {
  id         Int         @id @default(autoincrement())
  entity_key String
  row_id     Int
  action     AuditAction
  event      String?
  at         DateTime    @default(now()) @db.Timestamptz(6)
  by         Int

  @@index([entity_key, row_id])
  @@map("audit_log")
}
